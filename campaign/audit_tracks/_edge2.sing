// Case (2) lowest-weight edge equation, with both scalings normalized:
//   t -> lambda t and (C,G) -> (mu C, G/mu) act as c_i -> mu lambda^i c_i,
//   g_i -> g_i lambda^(i-3)/mu, so c_1 = c_8 = 1 is attainable over the
//   algebraic closure (needs a 7th root of c_1/c_8).  17 unknowns, 17 equations.
option(redSB);
ring R = 65521, (c(2..7), g(2..12), t), dp;
poly C = t^1 + t^8;
int i;
for (i = 2; i <= 7; i++) { C = C + c(i)*t^i; }
poly G = 0;
for (i = 2; i <= 12; i++) { G = G + g(i)*t^i; }
poly Eq = 2*C*diff(G,t) - 3*diff(C,t)*G - t^2;
ideal I;
matrix M = coeffs(Eq, t);
for (i = 1; i <= nrows(M); i++) { I = I + ideal(M[i,1]); }
"equations: " + string(size(simplify(I,2)));
ring R2 = 65521, (c(2..7), g(2..12)), dp;
ideal J = simplify(imap(R, I), 2);
J = sat(J, g(2)*g(12))[1];
ideal Gb = std(J);
if (size(Gb) == 1 && Gb[1] == 1) { "VERDICT: EMPTY"; }
else { "VERDICT: dim = " + string(dim(Gb));
       if (dim(Gb) == 0) { "vdim = " + string(vdim(Gb)); }
       "ngens = " + string(size(Gb)); }
quit;
