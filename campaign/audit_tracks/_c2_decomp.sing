(10578*a^6)*b(2)*al(2)+(7616*a)*b(2)*al(3)+(18769*a)*b(3)*al(2)+(46901*a^3)*b(3)*al(3)+(18786*a^3)*b(2)*b(2)*b(2)+(2606*a^5)*b(2)*b(2)*b(3)+(267)*b(2)*b(3)*b(3)+(20697*a^2)*b(3)*b(3)*b(3),
(65365*a^4)*b(2)*al(2)+(18980*a^6)*b(2)*al(3)+(8000*a^6)*b(3)*al(2)+(1762*a)*b(3)*al(3)+(65256*a)*b(2)*b(2)*b(2)+(32669*a^3)*b(2)*b(2)*b(3)+(58468*a^5)*b(2)*b(3)*b(3)+(48402)*b(3)*b(3)*b(3),
(32573*a^2)*b(2)*al(2)+(8275*a^4)*b(2)*al(3)+(48446*a^4)*b(3)*al(2)+(33570*a^6)*b(3)*al(3)+(29511*a^6)*b(2)*b(2)*b(2)+(52757*a)*b(2)*b(2)*b(3)+(32536*a^3)*b(2)*b(3)*b(3)+(47907*a^5)*b(3)*b(3)*b(3),
(2205)*b(2)*al(2)+(33021*a^2)*b(2)*al(3)+(19682*a^2)*b(3)*al(2)+(1366*a^4)*b(3)*al(3)+(39595*a^4)*b(2)*b(2)*b(2)+(20318*a^6)*b(2)*b(2)*b(3)+(57906*a)*b(2)*b(3)*b(3)+(23817*a^3)*b(3)*b(3)*b(3);
"gens: " + string(size(I));
