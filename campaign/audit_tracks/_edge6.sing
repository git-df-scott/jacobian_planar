option(redSB);
ring R = 65521, (c(2..7), g(2..12), t), dp;
poly C = t^1 + t^8;  int i;
for (i = 2; i <= 7; i++) { C = C + c(i)*t^i; }
poly G = 0;
for (i = 2; i <= 12; i++) { G = G + g(i)*t^i; }
poly Eq = 2*C*diff(G,t) - 3*diff(C,t)*G - t^2;
ideal I; matrix M = coeffs(Eq, t);
for (i = 1; i <= nrows(M); i++) { I = I + ideal(M[i,1]); }
ring R2 = 65521, (c(2..7), g(2..12)), lp;
ideal J0 = simplify(imap(R, I), 2);
// pick the three F_p-rational branches via the degree-5 eliminant of g(9)
int v;
for (v = 1; v <= 3; v++) {
  int gv = 0;
  if (v == 1) { gv = -4723; }
  if (v == 2) { gv = -17368; }
  if (v == 3) { gv = -24930; }
  ideal J = J0 + ideal(g(9) - gv);
  ideal Gb = std(J);
  "branch g9 = " + string(gv) + " : dim " + string(dim(Gb))
      + "  vdim " + string(vdim(Gb)) + "  ngens " + string(size(Gb));
  "   last gens: " + string(Gb[size(Gb)]) + " ;; " + string(Gb[size(Gb)-1]);
}
quit;
