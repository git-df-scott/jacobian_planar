LIB "primdec.lib";
option(redSB);
ring R = 65521, (c(2..7), g(2..12), t), dp;
poly C = t^1 + t^8;
int i;
for (i = 2; i <= 7; i++) { C = C + c(i)*t^i; }
poly G = 0;
for (i = 2; i <= 12; i++) { G = G + g(i)*t^i; }
poly Eq = 2*C*diff(G,t) - 3*diff(C,t)*G - t^2;
ideal I;
matrix M = coeffs(Eq, t);
for (i = 1; i <= nrows(M); i++) { I = I + ideal(M[i,1]); }
ring R2 = 65521, (c(2..7), g(2..12)), dp;
ideal J = std(simplify(imap(R, I), 2));
"dim = " + string(dim(J)) + "  vdim = " + string(vdim(J));
ideal U = finduni(J);
"univariate eliminants (one per variable):";
for (i = 1; i <= size(U); i++) {
  "  var " + string(i) + ":  deg " + string(deg(U[i])) + "   factors: " + string(factorize(U[i],2));
}
quit;
