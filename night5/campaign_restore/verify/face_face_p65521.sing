 -19*q1*t11 - 14*q2*t10 - 9*q3*t9 - 4*q4*t8 + q5*t7 + 6*q6*t6 + 11*q7*t5 + 16*t4,
 -17*q1*t10 - 12*q2*t9 - 7*q3*t8 - 2*q4*t7 + 3*q5*t6 + 8*q6*t5 + 13*q7*t4 + 18*t3,
 -15*q1*t9 - 10*q2*t8 - 5*q3*t7 + 5*q5*t5 + 10*q6*t4 + 15*q7*t3 + 20*t2,
