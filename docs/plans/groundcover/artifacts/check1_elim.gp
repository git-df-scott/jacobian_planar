default(parisize, 2*10^9);
f = (0)*x^0+(979890855497264250411926609342972328957862622093031383400352711216671227497456596598287622745773572096)*x^1+(-38742557163625230956044290853484342901229406150090509390142373783886185171244391723524165035814074187776)*x^2+(670989653197457275127849145233322212101620205058097151382968239198582586156174312953380540968447715167236)*x^3+(-6648890228017870042108274619361993493494029788634913464434054809925737281419866868256732784173358201407798)*x^4+(41229820718609225035802546139338732963281471727993831975617482253394604382774986248795647521375244790349915)*x^5+(-163835465150459730059084697984507278105886432829602698070851076572521193845919486203793297830558506396312192)*x^6+(407421725319496546080184092002576165943681858943362016992098340527733192993291406618634844440101106445925088)*x^7+(-579706363705353485379841464106362055987050694149853330967415638883863301007361184872890246772216214489409536)*x^8+(361344922804570659362035756066069952775013453244926727461127623373689793812185617612910020797376224314105600)*x^9;
print("DEG = ", poldegree(f));
print("content = ", content(f));
print("--- exact factorization over Q ---");
F = factor(f);
print("nfactors = ", matsize(F)[1]);
print("factor_degrees = ", [poldegree(z) | z <- F[,1]~]);
print("multiplicities = ", F[,2]~);
print("--- squarefree ---");
print("deg gcd(f,f prime) = ", poldegree(gcd(f, deriv(f))));
print("--- rational roots (degree-1 factors) ---");
print("n_rational_roots = ", sum(k=1, matsize(F)[1], if(poldegree(F[k,1])==1, F[k,2], 0)));
for(k=1, matsize(F)[1], print("  factor ", k, " deg=", poldegree(F[k,1]), " mult=", F[k,2], if(poldegree(F[k,1])<=2, Str("  poly=", F[k,1]), "")));
print("--- Galois groups of factors (deg<=7 native) ---");
for(k=1, matsize(F)[1], my(d=poldegree(F[k,1])); if(d>=2 && d<=7, print("  factor ", k, " deg ", d, " galois = ", polgalois(F[k,1])), if(d>7, print("  factor ", k, " deg ", d, " galois = SKIPPED (needs galdata)"))));
print("--- negative control ---");
print("  polgalois(x^5-5*x+12) = ", polgalois(x^5-5*x+12));
quit;
