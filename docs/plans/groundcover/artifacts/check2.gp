default(parisize, 2*10^9);
f = 28025486715771104897405802541699390376399300290198502385783996355229414659719168*w^5 - 20574572718708724763246730728744128775464672964247708234872924119799437271933037752352768*w^4 + 8825879233064727767908886167281876431879811954886593616749481756422860968267949715129660742519296*w^3 - 2177832405308085589158432507908947868381638402466821386643304409940636648700465447559360532420871455391808*w^2 + 249949126293676611427175216898050925930369696682426708018664131975004629966000788153502025657863646874482571817080*w - 1294685606251721097527002444154076091396466453169684000619527364670310418075204723775714559351336010512876335868206738251;
print("deg = ", poldegree(f));
print("content = ", content(f));
print("lead digits = ", #Str(polcoeff(f,5)));
print("--- squarefree: deg gcd(f,f') ---");
g = gcd(f, f');
print("deg gcd(f,f') = ", poldegree(g));
print("issquarefree = ", polisirreducible(f) || poldegree(gcd(f,f'))==0);
print("--- irreducibility over Q ---");
print("polisirreducible = ", polisirreducible(f));
print("factor degrees = ", [poldegree(z) | z <- factor(f)[,1]~]);
print("nfactors = ", matsize(factor(f))[1]);
print("--- rational roots ---");
print("nbrootsQ = ", #polrootsQ(f));
print("polrootsQ = ", polrootsQ(f));
print("--- discriminant ---");
D = poldisc(f);
print("disc digits = ", #Str(abs(D)));
print("disc sign = ", sign(D));
print("disc issquare = ", issquare(D));
print("--- Galois group (monic integral model) ---");
fm = polredbest(f);
print("polredbest = ", fm);
G = polgalois(f);
print("polgalois(f) = ", G);
print("--- NEGATIVE control: D5 quintic w^5-5w+12 ---");
print("polgalois(w^5-5*w+12) = ", polgalois(w^5-5*w+12));
print("--- NEGATIVE control: reducible (w^2+1)(w^3-2) ---");
print("polisirreducible((w^2+1)*(w^3-2)) = ", polisirreducible((w^2+1)*(w^3-2)));
quit;
