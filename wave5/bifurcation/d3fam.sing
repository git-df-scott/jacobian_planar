ring R = 0, (a2,a3,a4,a5,a6,b2,mu2,mu3), dp;
LIB "primdec.lib";
ideal I = -144*a6^2 - 24*a6 + 3,
-64*a5*a6 - 6*a5 - 12*a6*b2 + 3*b2,
-112*a4*a6 - 12*a4 - 56*a5^2 - 24*a5*b2 - 12*a6*b2^2 + 9*b2^2,
-96*a3*a6 - 12*a3 - 96*a4*a5 - 24*a4*b2 - 12*a5*b2^2 - 12*a6*mu3 + 6*b2^3 + 3*mu3,
-160*a2*a6 - 24*a2 - 160*a3*a5 - 48*a3*b2 - 80*a4^2 - 24*a4*b2^2 - 24*a5*mu3 - 24*a6*b2*mu3 + 3*b2^4 + 18*b2*mu3,
-64*a2*a5 - 24*a2*b2 - 64*a3*a4 - 12*a3*b2^2 - 12*a4*mu3 - 12*a5*b2*mu3 - 72*a6*mu2 + 9*b2^2*mu3 - 6*mu2,
-48*a2*a4 - 12*a2*b2^2 - 24*a3^2 - 12*a3*mu3 - 12*a4*b2*mu3 - 56*a5*mu2 + 12*a6*mu3^2 + 3*b2^3*mu3 - 12*b2*mu2 + 3*mu3^2,
-16*a2*a3 - 4*a2*mu3 - 6*a3*b2*mu3 - 20*a4*mu2 + 4*a5*mu3^2 - 3*b2^2*mu2 + 3*b2*mu3^2 + 4*b2*mu3,
-8*a2^2 - 8*a2*b2*mu3 - 24*a3*mu2 + 4*a4*mu3^2 + 3*b2^2*mu3^2 + 8*b2^2*mu3,
-2*a2*mu2,
2*b2*mu3^2;
list L = minAssGTZ(I);
print(size(L));
for (int i=1; i<=size(L); i++) { print("--- component, dim:"); print(dim(std(L[i]))); print(L[i]); }
quit;
