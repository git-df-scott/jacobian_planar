// Independent characteristic-zero construction from 2*C*G'-3*C'*G=t^2.
// Normalize c_1=c_8=1; this leaves all nonzero-corner orbits represented.
ring R=0,(c(3..7),t),dp;
option(redSB);
poly C=t+t^8;
int i;
for(i=3;i<=7;i++){C=C+c(i)*t^i;}
proc coefficient(poly p,int k){
  matrix M=coeffs(p,t);
  if(k+1>nrows(M)){return(poly(0));}
  return(M[k+1,1]);
}
poly G=0;
poly residual;
int n;
for(n=2;n<=12;n++){
  residual=2*C*diff(G,t)-3*diff(C,t)*G-t^2;
  G=G-coefficient(residual,n)*t^n/(2*n-3);
}
residual=2*C*diff(G,t)-3*diff(C,t)*G-t^2;
ideal E;
for(n=0;n<=19;n++){if(coefficient(residual,n)!=0){E=E+coefficient(residual,n);}}
E=simplify(E,2);
"GENERATORS="+string(size(E));
write(":w astra/artifacts/case2_exact_zero_input.txt",string(E));
ring S=0,(c(3..7)),dp;
ideal E=imap(R,E);
int started=timer;
ideal B=std(E);
"EXACT_Q_DIM="+string(dim(B));
"EXACT_Q_VDIM="+string(vdim(B));
"SECONDS="+string(timer-started);
write(":w astra/artifacts/case2_exact_zero_dp.txt",string(B));
matrix certificate=lift(E,B);
write(":w astra/artifacts/case2_exact_zero_certificate.txt",string(certificate));
"CERTIFICATE_ZERO="+string(size(ideal(matrix(E)*certificate-matrix(B))));
if(dim(B)==0){
  ring L=0,(c(3..7)),lp;
  ideal B=fglm(S,B);
  short=0;
  write(":w astra/artifacts/case2_exact_zero_lex.txt",string(B));
  "LEX_SIZE="+string(size(B));
  "LEADING_EXACT_Q_COMPLETE";
}
quit;
