h=x^5-x^4+3*x^3+3*x^2+26;
b=bnfinit(h,1);
c3=Mod((15000285910282089504192/60579126468209266677769)*x^0+(5134565172670933272/60579126468209266677769)*x^1+(-137539431432626359836/60579126468209266677769)*x^2+(-336800193197460147624/60579126468209266677769)*x^3+(84325443098952382698/60579126468209266677769)*x^4,h);
F=idealfactor(b,c3);
Jideal=idealhnf(b,1);
for(i=1,matsize(F)[1],if(F[i,2]<0,Jideal=idealmul(b,Jideal,idealpow(b,F[i,1],ceil(-F[i,2]/2)))));
v=bnfisprincipal(b,Jideal); print(v); print(nfbasistoalg(b,v[2]));
