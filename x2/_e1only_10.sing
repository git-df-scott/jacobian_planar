// Leading level E1 alone for the mu=2 family at parameter m.
// E1 is weighted-homogeneous with w(F_i) = i, so compute the homogeneous
// Groebner basis first (cheap) before slicing F_{m-1} = 1.
int m = 10; int nF = m-1; int dg = 3*m/2;
ring R0 = 32003, (FF(1..nF), T), wp(1,2,3,4,5,6,7,8,9, 1);
proc cf(poly p, int k) { matrix M = coeffs(p, T); if (k+1 > nrows(M)) { return(poly(0)); } return(M[k+1,1]); }
proc addall(poly p) { matrix M = coeffs(p,T); int k; ideal J; for (k=1; k<=nrows(M); k++) { J = J + ideal(M[k,1]); } return(J); }
int i; int n; poly cur; poly d;
poly f2 = T; for (i=1; i<=nF; i++) { f2 = f2 + FF(i)*T^(i+1); }
poly g3 = 0;
for (n=0; n<=dg-2; n++) { cur = 2*f2*diff(g3,T) - 3*diff(f2,T)*g3 - T^2; d = -cf(cur,n+2)/(1+2*n); g3 = g3 + d*T^(n+2); }
ideal E1 = simplify(addall(2*f2*diff(g3,T) - 3*diff(f2,T)*g3 - T^2),2);
"m=" + string(m) + " E1conds=" + string(size(E1));
ring RH = 32003, (FF(1..nF)), wp(1,2,3,4,5,6,7,8,9);
ideal E1 = imap(R0,E1);
"weighted-homogeneous: " + string(homog(E1));
ideal H = std(E1);
"homogeneous std: size " + string(size(H)) + "  dim " + string(dim(H));
ring RA = 32003, (FF(1..nF)), dp;
ideal E1 = imap(RH,E1) + ideal(FF(nF)-1);
option(redSB);
ideal J = std(E1);
"E1 slice: dim " + string(dim(J));
if (dim(J)==0) { "E1 vdim " + string(vdim(J)); }
ring Rl = 32003, (FF(1..nF)), lp;
ideal J = fglm(RA, J);
int k; for (k=1;k<=size(J);k++) { "TRI " + string(J[k]); }
quit;
