// Staged decision, WIDER question: Q's slices g2,g1,g0 are bounded only by a
// generous NW, not by the campaign's prescribed windows.  (g3's degree is
// forced to 3m/2 by the top coefficient: 2*deg g3 - 3*deg f2 must vanish.)
//   Stage 1: E1 (leading level, involves f2 only) -> triangular decomposition.
//   Stage 2: for each component, adjoin the lower levels and 1/(B_top * F_top).
LIB "triang.lib";
int m = MVAL;
int dg = 3*m/2;
int NW = 2*m+2;
int nF = m-1; int nA = m; int nB = m+1;
ring R0 = PCHAR, (F(1..nF), A(0..nA-1), B(0..nB-1), T), dp;
proc cf(poly p, int k) { matrix M = coeffs(p, T); if (k+1 > nrows(M)) { return(poly(0)); } return(M[k+1,1]); }
proc addall(poly p) { matrix M = coeffs(p,T); int k; ideal J; for (k=1; k<=nrows(M); k++) { J = J + ideal(M[k,1]); } return(J); }
int i; int n; poly cur; poly d;
poly f2 = T; for (i=1; i<=nF; i++) { f2 = f2 + F(i)*T^(i+1); }
poly f1 = 0; for (i=0; i<=nA-1; i++) { f1 = f1 + A(i)*T^(i+1); }
poly f0 = 0; for (i=0; i<=nB-1; i++) { f0 = f0 + B(i)*T^i; }
poly g3 = 0;
for (n=0; n<=dg-2; n++) { cur = 2*f2*diff(g3,T) - 3*diff(f2,T)*g3 - T^2; d = -cf(cur,n+2)/(1+2*n); g3 = g3 + d*T^(n+2); }
ideal E1 = simplify(addall(2*f2*diff(g3,T) - 3*diff(f2,T)*g3 - T^2),2);
poly src4 = f1*diff(g3,T) - 3*diff(f1,T)*g3;
poly g2 = 0;
for (n=0; n<=NW-2; n++) { cur = 2*f2*diff(g2,T) - 2*diff(f2,T)*g2 + src4; d = -cf(cur,n+2)/(2+2*n); g2 = g2 + d*T^(n+2); }
poly R4 = 2*f2*diff(g2,T) - 2*diff(f2,T)*g2 + src4;
poly src3 = f1*diff(g2,T) - 2*diff(f1,T)*g2 - 3*diff(f0,T)*g3;
poly g1 = 0;
for (n=0; n<=NW-1; n++) { cur = 2*f2*diff(g1,T) - diff(f2,T)*g1 + src3; d = -cf(cur,n+1)/(1+2*n); g1 = g1 + d*T^(n+1); }
poly R3 = 2*f2*diff(g1,T) - diff(f2,T)*g1 + src3;
poly src2 = f1*diff(g1,T) - diff(f1,T)*g1 - 2*diff(f0,T)*g2;
poly g0 = 0;
for (n=0; n<=NW-1; n++) { cur = 2*f2*diff(g0,T) + src2; d = -cf(cur,n+1)/(2+2*n); g0 = g0 + d*T^(n+1); }
ideal REST = simplify(addall(2*f2*diff(g0,T) + src2) + addall(R3) + addall(R4)
                      + addall(f1*diff(g0,T) - diff(f0,T)*g1), 2);
"WIDE m=" + string(m) + " NW=" + string(2*m+2) + " p=" + string(PCHAR) + " degP=" + string(3*m) + " degQ=" + string(9*m/2)
  + " unknowns=" + string(nF+nA+nB) + " E1conds=" + string(size(E1)) + " lower=" + string(size(REST));
ring R1 = PCHAR, (F(1..nF)), dp;
ideal E1 = imap(R0,E1) + ideal(F(nF)-1);
option(redSB);
ideal J = std(E1);
"  E1 (F_top=1): dim " + string(dim(J));
if (dim(J)>=0) { "  E1 vdim " + string(vdim(J)); }
if (dim(J) != 0) { "  E1 not zero-dimensional -- handle separately"; quit; }
ring R1l = PCHAR, (F(1..nF)), lp;
ideal J = fglm(R1, J);
list TR = triangMH(J);
int nc = size(TR);
"  triangular components: " + string(nc);
setring R0;
ring RF = PCHAR, (A(0..nA-1), B(0..nB-1), U, F(1..nF)), (dp(nA+nB+1), lp(nF));
ideal REST = imap(R0, REST);
int c;
for (c=1; c<=nc; c++) {
  setring R1l; ideal TC = TR[c];
  setring RF; ideal I = REST + imap(R1l,TC) + ideal(U*B(nB-1)-1);
  ideal G = std(I);
  "  comp " + string(c) + ": dim = " + string(dim(G)) + "  GB[1] = " + string(G[1]);
}
quit;
