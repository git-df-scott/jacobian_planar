ring R0 = 32003, (c(1..18), T), dp;
poly f0 = c(1)*T^0 + c(2)*T^1 + c(3)*T^2 + c(4)*T^3;
poly f1 = c(5)*T^1 + c(6)*T^2 + c(7)*T^3;
poly f2 = c(8)*T^1 + c(9)*T^2 + c(10)*T^3;
poly f3 = 1*T^1 + c(12)*T^2 + c(13)*T^3;
poly f4 = c(14)*T^2 + c(15)*T^3;
proc cf(poly q, int e) { matrix Mx = coeffs(q, T); if (e+1 > nrows(Mx)) { return(poly(0)); } return(Mx[e+1,1]); }
proc addall(poly q) { matrix Mx = coeffs(q,T); int e; ideal J; for (e=1; e<=nrows(Mx); e++) { J = J + ideal(Mx[e,1]); } return(J); }
poly cur; poly dd; int n; ideal RES;
poly src4 = 0 - T^2;
poly g4 = 0;
poly op4;
g4 = g4 + c(16)*T^2;
op4 = (4)*f4*diff(g4,T) - (4)*diff(f4,T)*g4 + src4;
dd = -cf(op4, 4)/(4);
g4 = g4 + dd*T^3;
op4 = (4)*f4*diff(g4,T) - (4)*diff(f4,T)*g4 + src4;
RES = RES + addall(op4);
poly src3 = (3)*f3*diff(g4,T) - (4)*diff(f3,T)*g4;
poly g3 = 0;
poly op3;
op3 = (4)*f4*diff(g3,T) - (3)*diff(f4,T)*g3 + src3;
dd = -cf(op3, 2)/(-2);
g3 = g3 + dd*T^1;
op3 = (4)*f4*diff(g3,T) - (3)*diff(f4,T)*g3 + src3;
dd = -cf(op3, 3)/(2);
g3 = g3 + dd*T^2;
op3 = (4)*f4*diff(g3,T) - (3)*diff(f4,T)*g3 + src3;
dd = -cf(op3, 4)/(6);
g3 = g3 + dd*T^3;
op3 = (4)*f4*diff(g3,T) - (3)*diff(f4,T)*g3 + src3;
RES = RES + addall(op3);
poly src2 = (2)*f2*diff(g4,T) - (4)*diff(f2,T)*g4 + (3)*f3*diff(g3,T) - (3)*diff(f3,T)*g3;
poly g2 = 0;
poly op2;
g2 = g2 + c(17)*T^1;
op2 = (4)*f4*diff(g2,T) - (2)*diff(f4,T)*g2 + src2;
dd = -cf(op2, 3)/(4);
g2 = g2 + dd*T^2;
op2 = (4)*f4*diff(g2,T) - (2)*diff(f4,T)*g2 + src2;
dd = -cf(op2, 4)/(8);
g2 = g2 + dd*T^3;
op2 = (4)*f4*diff(g2,T) - (2)*diff(f4,T)*g2 + src2;
RES = RES + addall(op2);
poly src1 = (1)*f1*diff(g4,T) - (4)*diff(f1,T)*g4 + (2)*f2*diff(g3,T) - (3)*diff(f2,T)*g3 + (3)*f3*diff(g2,T) - (2)*diff(f3,T)*g2;
poly g1 = 0;
poly op1;
op1 = (4)*f4*diff(g1,T) - (1)*diff(f4,T)*g1 + src1;
dd = -cf(op1, 2)/(2);
g1 = g1 + dd*T^1;
op1 = (4)*f4*diff(g1,T) - (1)*diff(f4,T)*g1 + src1;
dd = -cf(op1, 3)/(6);
g1 = g1 + dd*T^2;
op1 = (4)*f4*diff(g1,T) - (1)*diff(f4,T)*g1 + src1;
dd = -cf(op1, 4)/(10);
g1 = g1 + dd*T^3;
op1 = (4)*f4*diff(g1,T) - (1)*diff(f4,T)*g1 + src1;
RES = RES + addall(op1);
poly src0 = (0)*f0*diff(g4,T) - (4)*diff(f0,T)*g4 + (1)*f1*diff(g3,T) - (3)*diff(f1,T)*g3 + (2)*f2*diff(g2,T) - (2)*diff(f2,T)*g2 + (3)*f3*diff(g1,T) - (1)*diff(f3,T)*g1;
poly g0 = 0;
poly op0;
g0 = g0 + c(18)*T^0;
op0 = (4)*f4*diff(g0,T) - (0)*diff(f4,T)*g0 + src0;
dd = -cf(op0, 2)/(4);
g0 = g0 + dd*T^1;
op0 = (4)*f4*diff(g0,T) - (0)*diff(f4,T)*g0 + src0;
dd = -cf(op0, 3)/(8);
g0 = g0 + dd*T^2;
op0 = (4)*f4*diff(g0,T) - (0)*diff(f4,T)*g0 + src0;
dd = -cf(op0, 4)/(12);
g0 = g0 + dd*T^3;
op0 = (4)*f4*diff(g0,T) - (0)*diff(f4,T)*g0 + src0;
RES = RES + addall(op0);
RES = RES + addall((0)*f0*diff(g3,T) - (3)*diff(f0,T)*g3 + (1)*f1*diff(g2,T) - (2)*diff(f1,T)*g2 + (2)*f2*diff(g1,T) - (1)*diff(f2,T)*g1 + (3)*f3*diff(g0,T) - (0)*diff(f3,T)*g0);
RES = RES + addall((0)*f0*diff(g2,T) - (2)*diff(f0,T)*g2 + (1)*f1*diff(g1,T) - (1)*diff(f1,T)*g1 + (2)*f2*diff(g0,T) - (0)*diff(f2,T)*g0);
RES = RES + addall((0)*f0*diff(g1,T) - (1)*diff(f0,T)*g1 + (1)*f1*diff(g0,T) - (0)*diff(f1,T)*g0);
RES = RES + addall((0)*f0*diff(g0,T) - (0)*diff(f0,T)*g0);
RES = simplify(RES,2);
"CFG mu=3 rmax=4 smax=4 k=2 m=3 M=3 degP=12 degQ=12 vars=18 conds=" + string(size(RES));
ring RF = 32003, (c(1..18), U), dp;
ideal I = imap(R0,RES) + ideal(U*c(4)*c(15) - 1);
ideal G = std(I);
"VERDICT dim " + string(dim(G)) + " GB1 " + string(G[1]);
quit;