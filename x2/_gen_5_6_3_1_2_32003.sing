ring R0 = 32003, (c(1..16), T), dp;
poly f0 = c(1)*T^0 + c(2)*T^1 + c(3)*T^2;
poly f1 = c(4)*T^1 + c(5)*T^2;
poly f2 = c(6)*T^1 + c(7)*T^2;
poly f3 = c(8)*T^1 + c(9)*T^2;
poly f4 = c(10)*T^1 + c(11)*T^2;
poly f5 = 1*T^1 + c(13)*T^2;
poly f6 = c(14)*T^2;
proc cf(poly q, int e) { matrix Mx = coeffs(q, T); if (e+1 > nrows(Mx)) { return(poly(0)); } return(Mx[e+1,1]); }
proc addall(poly q) { matrix Mx = coeffs(q,T); int e; ideal J; for (e=1; e<=nrows(Mx); e++) { J = J + ideal(Mx[e,1]); } return(J); }
poly cur; poly dd; int n; ideal RES;
poly src3 = 0 - T^1;
poly g3 = 0;
poly op3;
g3 = g3 + c(15)*T^1;
op3 = (6)*f6*diff(g3,T) - (3)*diff(f6,T)*g3 + src3;
RES = RES + addall(op3);
poly src2 = (5)*f5*diff(g3,T) - (3)*diff(f5,T)*g3;
poly g2 = 0;
poly op2;
op2 = (6)*f6*diff(g2,T) - (2)*diff(f6,T)*g2 + src2;
dd = -cf(op2, 2)/(2);
g2 = g2 + dd*T^1;
op2 = (6)*f6*diff(g2,T) - (2)*diff(f6,T)*g2 + src2;
RES = RES + addall(op2);
poly src1 = (4)*f4*diff(g3,T) - (3)*diff(f4,T)*g3 + (5)*f5*diff(g2,T) - (2)*diff(f5,T)*g2;
poly g1 = 0;
poly op1;
op1 = (6)*f6*diff(g1,T) - (1)*diff(f6,T)*g1 + src1;
dd = -cf(op1, 2)/(4);
g1 = g1 + dd*T^1;
op1 = (6)*f6*diff(g1,T) - (1)*diff(f6,T)*g1 + src1;
RES = RES + addall(op1);
poly src0 = (3)*f3*diff(g3,T) - (3)*diff(f3,T)*g3 + (4)*f4*diff(g2,T) - (2)*diff(f4,T)*g2 + (5)*f5*diff(g1,T) - (1)*diff(f5,T)*g1;
poly g0 = 0;
poly op0;
g0 = g0 + c(16)*T^0;
op0 = (6)*f6*diff(g0,T) - (0)*diff(f6,T)*g0 + src0;
dd = -cf(op0, 2)/(6);
g0 = g0 + dd*T^1;
op0 = (6)*f6*diff(g0,T) - (0)*diff(f6,T)*g0 + src0;
RES = RES + addall(op0);
RES = RES + addall((2)*f2*diff(g3,T) - (3)*diff(f2,T)*g3 + (3)*f3*diff(g2,T) - (2)*diff(f3,T)*g2 + (4)*f4*diff(g1,T) - (1)*diff(f4,T)*g1 + (5)*f5*diff(g0,T) - (0)*diff(f5,T)*g0);
RES = RES + addall((1)*f1*diff(g3,T) - (3)*diff(f1,T)*g3 + (2)*f2*diff(g2,T) - (2)*diff(f2,T)*g2 + (3)*f3*diff(g1,T) - (1)*diff(f3,T)*g1 + (4)*f4*diff(g0,T) - (0)*diff(f4,T)*g0);
RES = RES + addall((0)*f0*diff(g3,T) - (3)*diff(f0,T)*g3 + (1)*f1*diff(g2,T) - (2)*diff(f1,T)*g2 + (2)*f2*diff(g1,T) - (1)*diff(f2,T)*g1 + (3)*f3*diff(g0,T) - (0)*diff(f3,T)*g0);
RES = RES + addall((0)*f0*diff(g2,T) - (2)*diff(f0,T)*g2 + (1)*f1*diff(g1,T) - (1)*diff(f1,T)*g1 + (2)*f2*diff(g0,T) - (0)*diff(f2,T)*g0);
RES = RES + addall((0)*f0*diff(g1,T) - (1)*diff(f0,T)*g1 + (1)*f1*diff(g0,T) - (0)*diff(f1,T)*g0);
RES = RES + addall((0)*f0*diff(g0,T) - (0)*diff(f0,T)*g0);
RES = simplify(RES,2);
"CFG mu=5 rmax=6 smax=3 k=1 m=2 M=1 degP=12 degQ=6 vars=16 conds=" + string(size(RES));
ring RF = 32003, (c(1..16), U), dp;
ideal I = imap(R0,RES) + ideal(U*c(3)*c(14) - 1);
ideal G = std(I);
"VERDICT dim " + string(dim(G)) + " GB1 " + string(G[1]);
quit;