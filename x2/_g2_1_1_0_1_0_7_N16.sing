ring R0 = 32003, (c(1..9), T), dp;
poly f0 = c(1)*T^0;
poly f1 = 1*T^1 + c(3)*T^2 + c(4)*T^3 + c(5)*T^4 + c(6)*T^5 + c(7)*T^6 + c(8)*T^7;
proc cf(poly q, int e) { matrix Mx = coeffs(q, T); if (e+1 > nrows(Mx)) { return(poly(0)); } return(Mx[e+1,1]); }
proc addall(poly q) { matrix Mx = coeffs(q,T); int e; ideal J; for (e=1; e<=nrows(Mx); e++) { J = J + ideal(Mx[e,1]); } return(J); }
poly dd; ideal RES;
poly src0 = 0 - T^1;
poly g0 = 0; poly op0;
g0 = g0 + c(9)*T^0;
op0 = (1)*f1*diff(g0,T) - (0)*diff(f1,T)*g0 + src0;
dd = -cf(op0, 1)/(1);
g0 = g0 + dd*T^1;
op0 = (1)*f1*diff(g0,T) - (0)*diff(f1,T)*g0 + src0;
dd = -cf(op0, 2)/(2);
g0 = g0 + dd*T^2;
op0 = (1)*f1*diff(g0,T) - (0)*diff(f1,T)*g0 + src0;
dd = -cf(op0, 3)/(3);
g0 = g0 + dd*T^3;
op0 = (1)*f1*diff(g0,T) - (0)*diff(f1,T)*g0 + src0;
dd = -cf(op0, 4)/(4);
g0 = g0 + dd*T^4;
op0 = (1)*f1*diff(g0,T) - (0)*diff(f1,T)*g0 + src0;
dd = -cf(op0, 5)/(5);
g0 = g0 + dd*T^5;
op0 = (1)*f1*diff(g0,T) - (0)*diff(f1,T)*g0 + src0;
dd = -cf(op0, 6)/(6);
g0 = g0 + dd*T^6;
op0 = (1)*f1*diff(g0,T) - (0)*diff(f1,T)*g0 + src0;
dd = -cf(op0, 7)/(7);
g0 = g0 + dd*T^7;
op0 = (1)*f1*diff(g0,T) - (0)*diff(f1,T)*g0 + src0;
dd = -cf(op0, 8)/(8);
g0 = g0 + dd*T^8;
op0 = (1)*f1*diff(g0,T) - (0)*diff(f1,T)*g0 + src0;
dd = -cf(op0, 9)/(9);
g0 = g0 + dd*T^9;
op0 = (1)*f1*diff(g0,T) - (0)*diff(f1,T)*g0 + src0;
dd = -cf(op0, 10)/(10);
g0 = g0 + dd*T^10;
op0 = (1)*f1*diff(g0,T) - (0)*diff(f1,T)*g0 + src0;
dd = -cf(op0, 11)/(11);
g0 = g0 + dd*T^11;
op0 = (1)*f1*diff(g0,T) - (0)*diff(f1,T)*g0 + src0;
dd = -cf(op0, 12)/(12);
g0 = g0 + dd*T^12;
op0 = (1)*f1*diff(g0,T) - (0)*diff(f1,T)*g0 + src0;
dd = -cf(op0, 13)/(13);
g0 = g0 + dd*T^13;
op0 = (1)*f1*diff(g0,T) - (0)*diff(f1,T)*g0 + src0;
dd = -cf(op0, 14)/(14);
g0 = g0 + dd*T^14;
op0 = (1)*f1*diff(g0,T) - (0)*diff(f1,T)*g0 + src0;
dd = -cf(op0, 15)/(15);
g0 = g0 + dd*T^15;
op0 = (1)*f1*diff(g0,T) - (0)*diff(f1,T)*g0 + src0;
dd = -cf(op0, 16)/(16);
g0 = g0 + dd*T^16;
op0 = (1)*f1*diff(g0,T) - (0)*diff(f1,T)*g0 + src0;
RES = RES + addall(op0);
RES = RES + addall((0)*f0*diff(g0,T) - (0)*diff(f0,T)*g0);
RES = simplify(RES,2);
"CFG mu=1 r=1 s=0 k=1 tops=(0, 7) M=16 degP=13 degQ=32 vars=9 conds=" + string(size(RES));
ring RF = 32003, (c(1..9), U), dp;
ideal I = imap(R0,RES) + ideal(U*c(1)*c(8) - 1);
ideal G = std(I);
"VERDICT dim " + string(dim(G)) + " GB1 " + string(G[1]);
quit;