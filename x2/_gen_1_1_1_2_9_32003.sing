ring R0 = 32003, (c(1..21), T), dp;
poly f0 = c(1)*T^0 + c(2)*T^1 + c(3)*T^2 + c(4)*T^3 + c(5)*T^4 + c(6)*T^5 + c(7)*T^6 + c(8)*T^7 + c(9)*T^8 + c(10)*T^9;
poly f1 = 1*T^1 + c(12)*T^2 + c(13)*T^3 + c(14)*T^4 + c(15)*T^5 + c(16)*T^6 + c(17)*T^7 + c(18)*T^8 + c(19)*T^9;
proc cf(poly q, int e) { matrix Mx = coeffs(q, T); if (e+1 > nrows(Mx)) { return(poly(0)); } return(Mx[e+1,1]); }
proc addall(poly q) { matrix Mx = coeffs(q,T); int e; ideal J; for (e=1; e<=nrows(Mx); e++) { J = J + ideal(Mx[e,1]); } return(J); }
poly cur; poly dd; int n; ideal RES;
poly src1 = 0 - T^2;
poly g1 = 0;
poly op1;
g1 = g1 + c(20)*T^1;
op1 = (1)*f1*diff(g1,T) - (1)*diff(f1,T)*g1 + src1;
dd = -cf(op1, 2)/(1);
g1 = g1 + dd*T^2;
op1 = (1)*f1*diff(g1,T) - (1)*diff(f1,T)*g1 + src1;
dd = -cf(op1, 3)/(2);
g1 = g1 + dd*T^3;
op1 = (1)*f1*diff(g1,T) - (1)*diff(f1,T)*g1 + src1;
dd = -cf(op1, 4)/(3);
g1 = g1 + dd*T^4;
op1 = (1)*f1*diff(g1,T) - (1)*diff(f1,T)*g1 + src1;
dd = -cf(op1, 5)/(4);
g1 = g1 + dd*T^5;
op1 = (1)*f1*diff(g1,T) - (1)*diff(f1,T)*g1 + src1;
dd = -cf(op1, 6)/(5);
g1 = g1 + dd*T^6;
op1 = (1)*f1*diff(g1,T) - (1)*diff(f1,T)*g1 + src1;
dd = -cf(op1, 7)/(6);
g1 = g1 + dd*T^7;
op1 = (1)*f1*diff(g1,T) - (1)*diff(f1,T)*g1 + src1;
dd = -cf(op1, 8)/(7);
g1 = g1 + dd*T^8;
op1 = (1)*f1*diff(g1,T) - (1)*diff(f1,T)*g1 + src1;
dd = -cf(op1, 9)/(8);
g1 = g1 + dd*T^9;
op1 = (1)*f1*diff(g1,T) - (1)*diff(f1,T)*g1 + src1;
RES = RES + addall(op1);
poly src0 = (0)*f0*diff(g1,T) - (1)*diff(f0,T)*g1;
poly g0 = 0;
poly op0;
g0 = g0 + c(21)*T^0;
op0 = (1)*f1*diff(g0,T) - (0)*diff(f1,T)*g0 + src0;
dd = -cf(op0, 1)/(1);
g0 = g0 + dd*T^1;
op0 = (1)*f1*diff(g0,T) - (0)*diff(f1,T)*g0 + src0;
dd = -cf(op0, 2)/(2);
g0 = g0 + dd*T^2;
op0 = (1)*f1*diff(g0,T) - (0)*diff(f1,T)*g0 + src0;
dd = -cf(op0, 3)/(3);
g0 = g0 + dd*T^3;
op0 = (1)*f1*diff(g0,T) - (0)*diff(f1,T)*g0 + src0;
dd = -cf(op0, 4)/(4);
g0 = g0 + dd*T^4;
op0 = (1)*f1*diff(g0,T) - (0)*diff(f1,T)*g0 + src0;
dd = -cf(op0, 5)/(5);
g0 = g0 + dd*T^5;
op0 = (1)*f1*diff(g0,T) - (0)*diff(f1,T)*g0 + src0;
dd = -cf(op0, 6)/(6);
g0 = g0 + dd*T^6;
op0 = (1)*f1*diff(g0,T) - (0)*diff(f1,T)*g0 + src0;
dd = -cf(op0, 7)/(7);
g0 = g0 + dd*T^7;
op0 = (1)*f1*diff(g0,T) - (0)*diff(f1,T)*g0 + src0;
dd = -cf(op0, 8)/(8);
g0 = g0 + dd*T^8;
op0 = (1)*f1*diff(g0,T) - (0)*diff(f1,T)*g0 + src0;
dd = -cf(op0, 9)/(9);
g0 = g0 + dd*T^9;
op0 = (1)*f1*diff(g0,T) - (0)*diff(f1,T)*g0 + src0;
RES = RES + addall(op0);
RES = RES + addall((0)*f0*diff(g0,T) - (0)*diff(f0,T)*g0);
RES = simplify(RES,2);
"CFG mu=1 rmax=1 smax=1 k=2 m=9 M=9 degP=18 degQ=18 vars=21 conds=" + string(size(RES));
ring RF = 32003, (c(1..21), U), dp;
ideal I = imap(R0,RES) + ideal(U*c(10)*c(19) - 1);
ideal G = std(I);
"VERDICT dim " + string(dim(G)) + " GB1 " + string(G[1]);
quit;