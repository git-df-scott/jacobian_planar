// End-to-end decision for the p108_525122 target at characteristic PCHAR.
// Stage 1: solve E1 (leading level, f2 only) -> triangular decomposition.
// Stage 2: for each component, run levels 4,3,2,1 with B(8) inverted.
LIB "triang.lib";
int P = PCHAR;
ring R0 = PCHAR, (F(1..7), A(0..7), B(0..8), T), dp;
proc cf(poly p, int k) { matrix M = coeffs(p, T); if (k+1 > nrows(M)) { return(poly(0)); } return(M[k+1,1]); }
proc addall(poly p) { matrix M = coeffs(p,T); int k; ideal J; for (k=1; k<=nrows(M); k++) { J = J + ideal(M[k,1]); } return(J); }
proc levels(list FVl)
{
  poly f2 = T; int i;
  for (i=1; i<=7; i++) { f2 = f2 + FVl[i]*T^(i+1); }
  poly f1 = 0; for (i=0; i<=7; i++) { f1 = f1 + A(i)*T^(i+1); }
  poly f0 = 0; for (i=0; i<=8; i++) { f0 = f0 + B(i)*T^i; }
  poly g3 = 0; poly cur; poly d; int n;
  for (n=0; n<=10; n++) { cur = 2*f2*diff(g3,T) - 3*diff(f2,T)*g3 - T^2; d = -cf(cur,n+2)/(1+2*n); g3 = g3 + d*T^(n+2); }
  poly R5 = 2*f2*diff(g3,T) - 3*diff(f2,T)*g3 - T^2;
  poly src4 = f1*diff(g3,T) - 3*diff(f1,T)*g3;
  poly g2 = 0;
  for (n=0; n<=10; n++) { cur = 2*f2*diff(g2,T) - 2*diff(f2,T)*g2 + src4; d = -cf(cur,n+2)/(2+2*n); g2 = g2 + d*T^(n+2); }
  poly R4 = 2*f2*diff(g2,T) - 2*diff(f2,T)*g2 + src4;
  poly src3 = f1*diff(g2,T) - 2*diff(f1,T)*g2 - 3*diff(f0,T)*g3;
  poly g1 = 0;
  for (n=0; n<=11; n++) { cur = 2*f2*diff(g1,T) - diff(f2,T)*g1 + src3; d = -cf(cur,n+1)/(1+2*n); g1 = g1 + d*T^(n+1); }
  poly R3 = 2*f2*diff(g1,T) - diff(f2,T)*g1 + src3;
  poly src2 = f1*diff(g1,T) - diff(f1,T)*g1 - 2*diff(f0,T)*g2;
  poly g0 = 0;
  for (n=0; n<=11; n++) { cur = 2*f2*diff(g0,T) + src2; d = -cf(cur,n+1)/(2+2*n); g0 = g0 + d*T^(n+1); }
  poly R2 = 2*f2*diff(g0,T) + src2;
  poly R1 = f1*diff(g0,T) - diff(f0,T)*g1;
  list out = simplify(addall(R5),2), simplify(addall(R4)+addall(R3)+addall(R2)+addall(R1),2);
  return(out);
}
list FS; int i;
for (i=1; i<=7; i++) { FS[i] = F(i); }
list LV = levels(FS);
ideal E1 = LV[1];
ideal REST = LV[2];
"E1 conditions: " + string(size(E1)) + "   lower-level conditions: " + string(size(REST));
// --- Stage 1 ---
ring R1 = PCHAR, (F(1..7)), dp;
ideal E1 = imap(R0, E1);
E1 = E1 + ideal(F(7)-1);
option(redSB);
ideal J = std(E1);
"E1 with F7=1:  dim " + string(dim(J)) + "   vdim " + string(vdim(J));
ring R1l = PCHAR, (F(1..7)), lp;
ideal J = fglm(R1, J);
list TR = triangMH(J);
"triangular components: " + string(size(TR));
for (i=1; i<=size(TR); i++) { "comp " + string(i) + ": " + string(TR[i]); }
// --- Stage 2: whole thing at once, E1 replaced by its lex GB ---
setring R0;
ideal LEX = imap(R1l, J);
ring RF = PCHAR, (A(0..7), B(0..8), U, F(1..7)), (dp(18), lp(7));
ideal I = imap(R0, REST) + imap(R0, LEX) + ideal(U*B(8)-1);
ideal G = std(I);
"FULL: dim = " + string(dim(G)) + "   GBsize = " + string(size(G));
if (size(G)==1) { "GB[1] = " + string(G[1]); }
if (dim(G)>=0) { "vdim = " + string(vdim(G)); }
quit;
