// Graded (one-variable) form of the p108_525122 extract system.
// P = f0(T) + f1(T)/y + f2(T)/y^2 ,  Q = g0 + g1/y + g2/y^2 + g3/y^3 , T = x y^2.
// {P_rho,Q_sigma} = y^(1-rho-sigma) (rho f g' - sigma f' g).
// Level rho+sigma = 5 carries x^2 = T^2 y^-4 ; levels 4,3,2,1 must vanish.
ring R = 32003, (F(1..7), A(0..7), B(0..8), T), dp;

poly f2 = T; int i;
for (i=1; i<=7; i++) { f2 = f2 + F(i)*T^(i+1); }      // f2 = T*(1 + sum F_i T^i)
poly f1 = 0;
for (i=0; i<=7; i++) { f1 = f1 + A(i)*T^(i+1); }      // f1 = T*A(T)
poly f0 = 0;
for (i=0; i<=8; i++) { f0 = f0 + B(i)*T^i; }          // f0 = B(T)

proc cf(poly p, int k) { matrix M = coeffs(p, T); if (k+1 > nrows(M)) { return(poly(0)); } return(M[k+1,1]); }

// ---- level 5 : 2 f2 g3' - 3 f2' g3 = T^2 ,  g3 = sum G3_n T^(2+n), n=0..10
poly g3 = 0; poly cur; poly d; int n;
for (n=0; n<=10; n++) {
  cur = 2*f2*diff(g3,T) - 3*diff(f2,T)*g3 - T^2;
  d = -cf(cur, n+2) / (1+2*n);
  g3 = g3 + d*T^(n+2);
}
poly R5 = 2*f2*diff(g3,T) - 3*diff(f2,T)*g3 - T^2;

// ---- level 4 : 2 f2 g2' - 2 f2' g2 + f1 g3' - 3 f1' g3 = 0
poly src4 = f1*diff(g3,T) - 3*diff(f1,T)*g3;
poly g2 = 0;
for (n=0; n<=10; n++) {
  cur = 2*f2*diff(g2,T) - 2*diff(f2,T)*g2 + src4;
  d = -cf(cur, n+2) / (2+2*n);
  g2 = g2 + d*T^(n+2);
}
poly R4 = 2*f2*diff(g2,T) - 2*diff(f2,T)*g2 + src4;

// ---- level 3 : 2 f2 g1' - f2' g1 + f1 g2' - 2 f1' g2 - 3 f0' g3 = 0
poly src3 = f1*diff(g2,T) - 2*diff(f1,T)*g2 - 3*diff(f0,T)*g3;
poly g1 = 0;
for (n=0; n<=11; n++) {
  cur = 2*f2*diff(g1,T) - diff(f2,T)*g1 + src3;
  d = -cf(cur, n+1) / (1+2*n);
  g1 = g1 + d*T^(n+1);
}
poly R3 = 2*f2*diff(g1,T) - diff(f2,T)*g1 + src3;

// ---- level 2 : 2 f2 g0' + f1 g1' - f1' g1 - 2 f0' g2 = 0
poly src2 = f1*diff(g1,T) - diff(f1,T)*g1 - 2*diff(f0,T)*g2;
poly g0 = 0;
for (n=0; n<=11; n++) {
  cur = 2*f2*diff(g0,T) + src2;
  d = -cf(cur, n+1) / (2+2*n);
  g0 = g0 + d*T^(n+1);
}
poly R2 = 2*f2*diff(g0,T) + src2;

// ---- level 1 : f1 g0' - f0' g1 = 0
poly R1 = f1*diff(g0,T) - diff(f0,T)*g1;

ideal I;
matrix M; int k;
poly rr;
for (k=0; k<=5; k++) { }
proc addall(poly p) { matrix M = coeffs(p,T); int k; ideal J; for (k=1; k<=nrows(M); k++) { J = J + ideal(M[k,1]); } return(J); }
I = addall(R5) + addall(R4) + addall(R3) + addall(R2) + addall(R1);
I = simplify(I,2);
"conditions: " + string(size(I));
"deg g3 = " + string(deg(g3)) + "  deg g2 = " + string(deg(g2)) + "  deg g1 = " + string(deg(g1)) + "  deg g0 = " + string(deg(g0));
write(":w /home/user/jacobian_planar/x2/graded_525122.gens", string(I));
quit;
