ring R0 = 32003, (c(1..15), T), dp;
poly f0 = c(1)*T^0 + c(2)*T^1 + c(3)*T^2 + c(4)*T^3 + c(5)*T^4;
poly f1 = c(6)*T^1 + c(7)*T^2 + c(8)*T^3 + c(9)*T^4;
poly f2 = 1*T^1 + c(11)*T^2 + c(12)*T^3 + c(13)*T^4;
proc cf(poly q, int e) { matrix Mx = coeffs(q, T); if (e+1 > nrows(Mx)) { return(poly(0)); } return(Mx[e+1,1]); }
proc addall(poly q) { matrix Mx = coeffs(q,T); int e; ideal J; for (e=1; e<=nrows(Mx); e++) { J = J + ideal(Mx[e,1]); } return(J); }
poly cur; poly dd; int n; ideal RES;
poly src3 = 0 - T^2;
poly g3 = 0;
poly op3;
op3 = (2)*f2*diff(g3,T) - (3)*diff(f2,T)*g3 + src3;
dd = -cf(op3, 2)/(1);
g3 = g3 + dd*T^2;
op3 = (2)*f2*diff(g3,T) - (3)*diff(f2,T)*g3 + src3;
dd = -cf(op3, 3)/(3);
g3 = g3 + dd*T^3;
op3 = (2)*f2*diff(g3,T) - (3)*diff(f2,T)*g3 + src3;
dd = -cf(op3, 4)/(5);
g3 = g3 + dd*T^4;
op3 = (2)*f2*diff(g3,T) - (3)*diff(f2,T)*g3 + src3;
dd = -cf(op3, 5)/(7);
g3 = g3 + dd*T^5;
op3 = (2)*f2*diff(g3,T) - (3)*diff(f2,T)*g3 + src3;
dd = -cf(op3, 6)/(9);
g3 = g3 + dd*T^6;
op3 = (2)*f2*diff(g3,T) - (3)*diff(f2,T)*g3 + src3;
RES = RES + addall(op3);
poly src2 = (1)*f1*diff(g3,T) - (3)*diff(f1,T)*g3;
poly g2 = 0;
poly op2;
g2 = g2 + c(14)*T^1;
op2 = (2)*f2*diff(g2,T) - (2)*diff(f2,T)*g2 + src2;
dd = -cf(op2, 2)/(2);
g2 = g2 + dd*T^2;
op2 = (2)*f2*diff(g2,T) - (2)*diff(f2,T)*g2 + src2;
dd = -cf(op2, 3)/(4);
g2 = g2 + dd*T^3;
op2 = (2)*f2*diff(g2,T) - (2)*diff(f2,T)*g2 + src2;
dd = -cf(op2, 4)/(6);
g2 = g2 + dd*T^4;
op2 = (2)*f2*diff(g2,T) - (2)*diff(f2,T)*g2 + src2;
dd = -cf(op2, 5)/(8);
g2 = g2 + dd*T^5;
op2 = (2)*f2*diff(g2,T) - (2)*diff(f2,T)*g2 + src2;
dd = -cf(op2, 6)/(10);
g2 = g2 + dd*T^6;
op2 = (2)*f2*diff(g2,T) - (2)*diff(f2,T)*g2 + src2;
RES = RES + addall(op2);
poly src1 = (0)*f0*diff(g3,T) - (3)*diff(f0,T)*g3 + (1)*f1*diff(g2,T) - (2)*diff(f1,T)*g2;
poly g1 = 0;
poly op1;
op1 = (2)*f2*diff(g1,T) - (1)*diff(f2,T)*g1 + src1;
dd = -cf(op1, 1)/(1);
g1 = g1 + dd*T^1;
op1 = (2)*f2*diff(g1,T) - (1)*diff(f2,T)*g1 + src1;
dd = -cf(op1, 2)/(3);
g1 = g1 + dd*T^2;
op1 = (2)*f2*diff(g1,T) - (1)*diff(f2,T)*g1 + src1;
dd = -cf(op1, 3)/(5);
g1 = g1 + dd*T^3;
op1 = (2)*f2*diff(g1,T) - (1)*diff(f2,T)*g1 + src1;
dd = -cf(op1, 4)/(7);
g1 = g1 + dd*T^4;
op1 = (2)*f2*diff(g1,T) - (1)*diff(f2,T)*g1 + src1;
dd = -cf(op1, 5)/(9);
g1 = g1 + dd*T^5;
op1 = (2)*f2*diff(g1,T) - (1)*diff(f2,T)*g1 + src1;
dd = -cf(op1, 6)/(11);
g1 = g1 + dd*T^6;
op1 = (2)*f2*diff(g1,T) - (1)*diff(f2,T)*g1 + src1;
RES = RES + addall(op1);
poly src0 = (0)*f0*diff(g2,T) - (2)*diff(f0,T)*g2 + (1)*f1*diff(g1,T) - (1)*diff(f1,T)*g1;
poly g0 = 0;
poly op0;
g0 = g0 + c(15)*T^0;
op0 = (2)*f2*diff(g0,T) - (0)*diff(f2,T)*g0 + src0;
dd = -cf(op0, 1)/(2);
g0 = g0 + dd*T^1;
op0 = (2)*f2*diff(g0,T) - (0)*diff(f2,T)*g0 + src0;
dd = -cf(op0, 2)/(4);
g0 = g0 + dd*T^2;
op0 = (2)*f2*diff(g0,T) - (0)*diff(f2,T)*g0 + src0;
dd = -cf(op0, 3)/(6);
g0 = g0 + dd*T^3;
op0 = (2)*f2*diff(g0,T) - (0)*diff(f2,T)*g0 + src0;
dd = -cf(op0, 4)/(8);
g0 = g0 + dd*T^4;
op0 = (2)*f2*diff(g0,T) - (0)*diff(f2,T)*g0 + src0;
dd = -cf(op0, 5)/(10);
g0 = g0 + dd*T^5;
op0 = (2)*f2*diff(g0,T) - (0)*diff(f2,T)*g0 + src0;
dd = -cf(op0, 6)/(12);
g0 = g0 + dd*T^6;
op0 = (2)*f2*diff(g0,T) - (0)*diff(f2,T)*g0 + src0;
RES = RES + addall(op0);
RES = RES + addall((0)*f0*diff(g1,T) - (1)*diff(f0,T)*g1 + (1)*f1*diff(g0,T) - (0)*diff(f1,T)*g0);
RES = RES + addall((0)*f0*diff(g0,T) - (0)*diff(f0,T)*g0);
RES = simplify(RES,2);
"CFG mu=2 rmax=2 smax=3 k=2 m=4 M=6 degP=12 degQ=18 vars=15 conds=" + string(size(RES));
ring RF = 32003, (c(1..15), U), dp;
ideal I = imap(R0,RES) + ideal(U*c(5)*c(13) - 1);
ideal G = std(I);
"VERDICT dim " + string(dim(G)) + " GB1 " + string(G[1]);
quit;