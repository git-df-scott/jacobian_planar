ring R0 = 32003, (c(1..17), T), dp;
poly f0 = c(1)*T^0 + c(2)*T^1 + c(3)*T^2;
poly f1 = c(4)*T^1 + c(5)*T^2;
poly f2 = c(6)*T^1 + c(7)*T^2;
poly f3 = c(8)*T^1 + c(9)*T^2;
poly f4 = c(10)*T^1 + c(11)*T^2;
poly f5 = 1*T^1 + c(13)*T^2;
poly f6 = c(14)*T^2;
poly f7 = c(15)*T^2;
proc cf(poly q, int e) { matrix Mx = coeffs(q, T); if (e+1 > nrows(Mx)) { return(poly(0)); } return(Mx[e+1,1]); }
proc addall(poly q) { matrix Mx = coeffs(q,T); int e; ideal J; for (e=1; e<=nrows(Mx); e++) { J = J + ideal(Mx[e,1]); } return(J); }
poly cur; poly dd; int n; ideal RES;
poly src7 = 0 - T^2;
poly g7 = 0;
poly op7;
g7 = g7 + c(16)*T^2;
op7 = (7)*f7*diff(g7,T) - (7)*diff(f7,T)*g7 + src7;
RES = RES + addall(op7);
poly src6 = (6)*f6*diff(g7,T) - (7)*diff(f6,T)*g7;
poly g6 = 0;
poly op6;
op6 = (7)*f7*diff(g6,T) - (6)*diff(f7,T)*g6 + src6;
dd = -cf(op6, 3)/(2);
g6 = g6 + dd*T^2;
op6 = (7)*f7*diff(g6,T) - (6)*diff(f7,T)*g6 + src6;
RES = RES + addall(op6);
poly src5 = (5)*f5*diff(g7,T) - (7)*diff(f5,T)*g7 + (6)*f6*diff(g6,T) - (6)*diff(f6,T)*g6;
poly g5 = 0;
poly op5;
op5 = (7)*f7*diff(g5,T) - (5)*diff(f7,T)*g5 + src5;
dd = -cf(op5, 2)/(-3);
g5 = g5 + dd*T^1;
op5 = (7)*f7*diff(g5,T) - (5)*diff(f7,T)*g5 + src5;
dd = -cf(op5, 3)/(4);
g5 = g5 + dd*T^2;
op5 = (7)*f7*diff(g5,T) - (5)*diff(f7,T)*g5 + src5;
RES = RES + addall(op5);
poly src4 = (4)*f4*diff(g7,T) - (7)*diff(f4,T)*g7 + (5)*f5*diff(g6,T) - (6)*diff(f5,T)*g6 + (6)*f6*diff(g5,T) - (5)*diff(f6,T)*g5;
poly g4 = 0;
poly op4;
op4 = (7)*f7*diff(g4,T) - (4)*diff(f7,T)*g4 + src4;
dd = -cf(op4, 2)/(-1);
g4 = g4 + dd*T^1;
op4 = (7)*f7*diff(g4,T) - (4)*diff(f7,T)*g4 + src4;
dd = -cf(op4, 3)/(6);
g4 = g4 + dd*T^2;
op4 = (7)*f7*diff(g4,T) - (4)*diff(f7,T)*g4 + src4;
RES = RES + addall(op4);
poly src3 = (3)*f3*diff(g7,T) - (7)*diff(f3,T)*g7 + (4)*f4*diff(g6,T) - (6)*diff(f4,T)*g6 + (5)*f5*diff(g5,T) - (5)*diff(f5,T)*g5 + (6)*f6*diff(g4,T) - (4)*diff(f6,T)*g4;
poly g3 = 0;
poly op3;
op3 = (7)*f7*diff(g3,T) - (3)*diff(f7,T)*g3 + src3;
dd = -cf(op3, 2)/(1);
g3 = g3 + dd*T^1;
op3 = (7)*f7*diff(g3,T) - (3)*diff(f7,T)*g3 + src3;
dd = -cf(op3, 3)/(8);
g3 = g3 + dd*T^2;
op3 = (7)*f7*diff(g3,T) - (3)*diff(f7,T)*g3 + src3;
RES = RES + addall(op3);
poly src2 = (2)*f2*diff(g7,T) - (7)*diff(f2,T)*g7 + (3)*f3*diff(g6,T) - (6)*diff(f3,T)*g6 + (4)*f4*diff(g5,T) - (5)*diff(f4,T)*g5 + (5)*f5*diff(g4,T) - (4)*diff(f5,T)*g4 + (6)*f6*diff(g3,T) - (3)*diff(f6,T)*g3;
poly g2 = 0;
poly op2;
op2 = (7)*f7*diff(g2,T) - (2)*diff(f7,T)*g2 + src2;
dd = -cf(op2, 2)/(3);
g2 = g2 + dd*T^1;
op2 = (7)*f7*diff(g2,T) - (2)*diff(f7,T)*g2 + src2;
dd = -cf(op2, 3)/(10);
g2 = g2 + dd*T^2;
op2 = (7)*f7*diff(g2,T) - (2)*diff(f7,T)*g2 + src2;
RES = RES + addall(op2);
poly src1 = (1)*f1*diff(g7,T) - (7)*diff(f1,T)*g7 + (2)*f2*diff(g6,T) - (6)*diff(f2,T)*g6 + (3)*f3*diff(g5,T) - (5)*diff(f3,T)*g5 + (4)*f4*diff(g4,T) - (4)*diff(f4,T)*g4 + (5)*f5*diff(g3,T) - (3)*diff(f5,T)*g3 + (6)*f6*diff(g2,T) - (2)*diff(f6,T)*g2;
poly g1 = 0;
poly op1;
op1 = (7)*f7*diff(g1,T) - (1)*diff(f7,T)*g1 + src1;
dd = -cf(op1, 2)/(5);
g1 = g1 + dd*T^1;
op1 = (7)*f7*diff(g1,T) - (1)*diff(f7,T)*g1 + src1;
dd = -cf(op1, 3)/(12);
g1 = g1 + dd*T^2;
op1 = (7)*f7*diff(g1,T) - (1)*diff(f7,T)*g1 + src1;
RES = RES + addall(op1);
poly src0 = (0)*f0*diff(g7,T) - (7)*diff(f0,T)*g7 + (1)*f1*diff(g6,T) - (6)*diff(f1,T)*g6 + (2)*f2*diff(g5,T) - (5)*diff(f2,T)*g5 + (3)*f3*diff(g4,T) - (4)*diff(f3,T)*g4 + (4)*f4*diff(g3,T) - (3)*diff(f4,T)*g3 + (5)*f5*diff(g2,T) - (2)*diff(f5,T)*g2 + (6)*f6*diff(g1,T) - (1)*diff(f6,T)*g1;
poly g0 = 0;
poly op0;
g0 = g0 + c(17)*T^0;
op0 = (7)*f7*diff(g0,T) - (0)*diff(f7,T)*g0 + src0;
dd = -cf(op0, 2)/(7);
g0 = g0 + dd*T^1;
op0 = (7)*f7*diff(g0,T) - (0)*diff(f7,T)*g0 + src0;
dd = -cf(op0, 3)/(14);
g0 = g0 + dd*T^2;
op0 = (7)*f7*diff(g0,T) - (0)*diff(f7,T)*g0 + src0;
RES = RES + addall(op0);
RES = RES + addall((0)*f0*diff(g6,T) - (6)*diff(f0,T)*g6 + (1)*f1*diff(g5,T) - (5)*diff(f1,T)*g5 + (2)*f2*diff(g4,T) - (4)*diff(f2,T)*g4 + (3)*f3*diff(g3,T) - (3)*diff(f3,T)*g3 + (4)*f4*diff(g2,T) - (2)*diff(f4,T)*g2 + (5)*f5*diff(g1,T) - (1)*diff(f5,T)*g1 + (6)*f6*diff(g0,T) - (0)*diff(f6,T)*g0);
RES = RES + addall((0)*f0*diff(g5,T) - (5)*diff(f0,T)*g5 + (1)*f1*diff(g4,T) - (4)*diff(f1,T)*g4 + (2)*f2*diff(g3,T) - (3)*diff(f2,T)*g3 + (3)*f3*diff(g2,T) - (2)*diff(f3,T)*g2 + (4)*f4*diff(g1,T) - (1)*diff(f4,T)*g1 + (5)*f5*diff(g0,T) - (0)*diff(f5,T)*g0);
RES = RES + addall((0)*f0*diff(g4,T) - (4)*diff(f0,T)*g4 + (1)*f1*diff(g3,T) - (3)*diff(f1,T)*g3 + (2)*f2*diff(g2,T) - (2)*diff(f2,T)*g2 + (3)*f3*diff(g1,T) - (1)*diff(f3,T)*g1 + (4)*f4*diff(g0,T) - (0)*diff(f4,T)*g0);
RES = RES + addall((0)*f0*diff(g3,T) - (3)*diff(f0,T)*g3 + (1)*f1*diff(g2,T) - (2)*diff(f1,T)*g2 + (2)*f2*diff(g1,T) - (1)*diff(f2,T)*g1 + (3)*f3*diff(g0,T) - (0)*diff(f3,T)*g0);
RES = RES + addall((0)*f0*diff(g2,T) - (2)*diff(f0,T)*g2 + (1)*f1*diff(g1,T) - (1)*diff(f1,T)*g1 + (2)*f2*diff(g0,T) - (0)*diff(f2,T)*g0);
RES = RES + addall((0)*f0*diff(g1,T) - (1)*diff(f0,T)*g1 + (1)*f1*diff(g0,T) - (0)*diff(f1,T)*g0);
RES = RES + addall((0)*f0*diff(g0,T) - (0)*diff(f0,T)*g0);
RES = simplify(RES,2);
"CFG mu=5 rmax=7 smax=7 k=2 m=2 M=2 degP=12 degQ=12 vars=17 conds=" + string(size(RES));
ring RF = 32003, (c(1..17), U), dp;
ideal I = imap(R0,RES) + ideal(U*c(3)*c(15) - 1);
ideal G = std(I);
"VERDICT dim " + string(dim(G)) + " GB1 " + string(G[1]);
quit;