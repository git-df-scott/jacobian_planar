//////////////////////////////////////////////////////////////////////////
// Plane Jacobian campaign - Phase 2, probe 6
// THE CONTACT EXPONENT k, DERIVED - AND THE FINAL CLOSURE
//
// Session 21 left the D <= 3 window open under the ASSUMPTION that a
// (5,2) cusp has contact exponent k = 3.  The symbolic derivation in
// ../certify/session22_contact_exponent.py replaces that assumption:
// from the cusp identity
//
//     {y1,y2} = {W,y2} / ( m (y2^n + W)^((m-1)/m) )        (exact)
//
// and the leading blocks y2 ~ q^-beta v^-gamma g^mu,
// W ~ q^-lambda v^-sigma g^nu R, the bracket has the closed form
//
//   {W,y2} = q^(-lambda-beta-1) v^(-sigma-gamma) *
//            [ (lambda*gamma - beta*sigma) v^-1 g^(nu+mu) R
//              + (beta*nu - lambda*mu) g^(nu+mu-1) g' R
//              + beta g^(nu+mu) R' ]
//
// whence  s = beta/m  and  G = nu + mu - mu*n(m-1)/m.  Two of those
// exponents are forced: nu = mu*n (W = y1^m - y2^n inherits g^(mu n)
// from y2^n) and mu = m (y2's leading block is an m-th power), giving
// G = m+n and, with g = alpha*U^eps*(unit),
//
//     k = eps*(m+n) - 1.
//
// For (2,3) at eps = 1 that is 4 - the First Framework's value, and the
// whole Session-18 master identity comes back out exactly.  For (5,2)
// it is 6, NOT the 3 Session 21 assumed.
//
// THE CLOSURE.  m, n coprime with m, n >= 2 force m + n >= 5, so
// k >= 4 for every cusp type and every eps.  Session 20's
// self-consistency forces D = k, hence D >= 4 always, and Session 20's
// Belyi gate closes every D >= 4.  The D <= 3 window is EMPTY.
//
// This probe carries out the closure arithmetic and re-runs the Belyi
// gate at exactly the derived values D = k, so the two halves are
// checked against each other rather than asserted side by side.
//////////////////////////////////////////////////////////////////////////

int NB = 6;
ring RV = 0, (a(0..40), c, v, t), dp;

proc esys(int J, int k, int s, int D, int M)
{
  poly A;  int i;
  for (i = 0; i <= M; i++) { A = A + a(i)*v^i; }
  poly E = s*v*((v+1)*diff(A,v) - J*A) - D*A;
  if (J <= k) { E = E*(v+1)^(k-J) + c; }
  else        { E = E + c*(v+1)^(J-k); }
  matrix K = coeffs(E, v);
  ideal I;
  for (i = 1; i <= nrows(K); i++) { I = I, K[i,1]; }
  return(simplify(I,2));
}

proc unum(int k, int s, int D, int M)
{
  ideal SI = std(esys(k,k,s,D,M));
  poly A;  int i;
  if (reduce(c, SI) == 0) { return(A); }
  for (i = 0; i <= M; i++) { A = A + subst(reduce(a(i), SI), c, 1)*v^i; }
  return(A);
}

proc ncritvals(poly A, int k)
"number of DISTINCT finite critical values of R = A/(v+1)^k"
{
  poly den = (v+1)^k;
  poly Nc = diff(A,v)*den - A*diff(den,v);
  Nc = Nc/gcd(Nc,den);
  poly rs = resultant(Nc, A - t*den, v);
  poly sq = rs/gcd(rs, diff(rs,t));
  return(deg(sq));
}

"=====================================================================";
"PROBE 6a  THE DERIVED CONTACT EXPONENT  k = eps*(m+n) - 1";
"          and the gate it has to face:  self-consistency forces D = k,";
"          so every cusp type is tested at its OWN derived degree.";
"=====================================================================";
"    cusp (m,n) | eps | k = D | s = n | resonance? | Belyi gate | verdict";
int m, n, e, k, s, D, nfin;
poly A;
string verdict, gate, reso;
for (m = 2; m <= 7; m++)
{
  for (n = 2; n <= 7; n++)
  {
    if (gcd(m,n) == 1)
    {
      for (e = 1; e <= 2; e++)
      {
        k = e*(m+n) - 1;  D = k;  s = n;
        if (D <= 12)                       // keep the resultants small
        {
          reso = "no ";  gate = "  -  ";  verdict = "CLOSED";
          if (D % s == 0 && D div s <= k) { reso = "YES"; }
          else
          {
            A = unum(D, s, D, D + NB);
            if (A == 0) { gate = "no sol"; }
            else
            {
              nfin = ncritvals(A, D);
              if (nfin + 1 <= 3) { gate = "CLEARS"; verdict = "OPEN  "; }
              else { gate = "fails "; }
            }
          }
          "      (" + string(m) + "," + string(n) + ")    |  " + string(e)
              + "  |  " + string(D) + "   |   " + string(s) + "   |    "
              + reso + "     |   " + gate + "  | " + verdict;
        }
      }
    }
  }
}
"";
"   Every row is CLOSED: at its own derived contact exponent each cusp";
"   type lands at D = k >= 4, where the Belyi gate fails (or, when the";
"   cusp exponent divides D, dies earlier by resonance collision).";

"";
"=====================================================================";
"PROBE 6b  WHY k CAN NEVER REACH 3";
"=====================================================================";
"    m, n coprime cusp exponents with m, n >= 2  =>  m + n >= 5";
"    eps >= 1                                    =>  k >= 4";
int kmin = 10000;
for (m = 2; m <= 40; m++)
{
  for (n = 2; n <= 40; n++)
  {
    if (gcd(m,n) == 1)
    {
      for (e = 1; e <= 12; e++)
      { if (e*(m+n)-1 < kmin) { kmin = e*(m+n)-1; } }
    }
  }
}
"    minimum of k over m,n <= 40 coprime and eps <= 12 :", kmin;
"    attained only at (m,n) = (2,3), eps = 1 - Borisov's own cusp.";
"";
"    ROBUSTNESS.  Dropping the step mu = m, the window would need";
"    G = mu(m+n)/m <= 4, i.e. mu <= 4m/(m+n) <= 4m/5 < m: y2's leading";
"    block would have to carry a g-power strictly below m, contradicting";
"    its being an m-th power at all.  The closure does not depend on it.";

"";
"=====================================================================";
"FINAL STATE";
"=====================================================================";
"   D >= 4 : closed by the Belyi gate (probe 4c), uniformly in the cusp";
"            exponent, with no upper bound on D.";
"   D <= 3 : closed here - no cusp type can produce a contact exponent";
"            that low, and self-consistency forces D = k.";
"";
"   Every gate is shut.  The published constructive framework family";
"   supports no Keller map, for any cusp type, cancellation depth,";
"   boundary order or chain degree.";
"";
"   No counterexample was found.  This closes the constructive";
"   candidates; the plane Jacobian conjecture itself is untouched.";
quit;
