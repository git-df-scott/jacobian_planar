LIB "elim.lib";
LIB "primdec.lib";
option(redSB);
ring R = 65521, (c(2..7), g(2..12), t), dp;
poly C = t^1 + t^8;
int i;
for (i = 2; i <= 7; i++) { C = C + c(i)*t^i; }
poly G = 0;
for (i = 2; i <= 12; i++) { G = G + g(i)*t^i; }
poly Eq = 2*C*diff(G,t) - 3*diff(C,t)*G - t^2;
ideal I;
matrix M = coeffs(Eq, t);
for (i = 1; i <= nrows(M); i++) { I = I + ideal(M[i,1]); }
ring R2 = 65521, (c(2..7), g(2..12)), dp;
ideal J = simplify(imap(R, I), 2);
"raw:        dim = " + string(dim(std(J))) + "   vdim = " + string(vdim(std(J)));
ideal Js = sat(J, g(2)*g(12))[1];
ideal Gs = std(Js);
if (size(Gs) == 1 && Gs[1] == 1) { "SATURATED (g2,g12 != 0): EMPTY"; }
else { "saturated:  dim = " + string(dim(Gs)) + "   vdim = " + string(vdim(Gs)); }
quit;
