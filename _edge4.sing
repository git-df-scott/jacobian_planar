// Vertex conditions imposed by Rabinowitsch (w * g_2 * g_12 = 1), which needs
// no library and cannot be corrupted by sat/primdec redefinitions.
option(redSB);
ring R = 65521, (c(2..7), g(2..12), t), dp;
poly C = t^1 + t^8;
int i;
for (i = 2; i <= 7; i++) { C = C + c(i)*t^i; }
poly G = 0;
for (i = 2; i <= 12; i++) { G = G + g(i)*t^i; }
poly Eq = 2*C*diff(G,t) - 3*diff(C,t)*G - t^2;
ideal I;
matrix M = coeffs(Eq, t);
for (i = 1; i <= nrows(M); i++) { I = I + ideal(M[i,1]); }
ring R2 = 65521, (c(2..7), g(2..12), w), dp;
ideal J = imap(R, I);
J = J + ideal(w*g(2)*g(12) - 1);
ideal Gb = std(J);
if (size(Gb) == 1 && Gb[1] == 1) { "VERDICT: EMPTY (no C,G with g_2, g_12 nonzero)"; }
else { "VERDICT: dim = " + string(dim(Gb));
       if (dim(Gb) == 0) { "vdim = " + string(vdim(Gb)); }
       "ngens = " + string(size(Gb)); }
quit;
