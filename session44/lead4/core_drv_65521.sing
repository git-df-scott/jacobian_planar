ring R = 65521, (A(0..7), B(0..10), z), dp;
ideal I = A(0)*B(0) - 1,
  3*A(0)*B(1) - 2*A(1)*B(0),
  5*A(0)*B(2) - 5*A(2)*B(0),
  7*A(0)*B(3) + 2*A(1)*B(2) - 3*A(2)*B(1) - 8*A(3)*B(0),
  9*A(0)*B(4) + 4*A(1)*B(3) - A(2)*B(2) - 6*A(3)*B(1) - 11*A(4)*B(0),
  11*A(0)*B(5) + 6*A(1)*B(4) + A(2)*B(3) - 4*A(3)*B(2) - 9*A(4)*B(1) - 14*A(5)*B(0),
  13*A(0)*B(6) + 8*A(1)*B(5) + 3*A(2)*B(4) - 2*A(3)*B(3) - 7*A(4)*B(2) - 12*A(5)*B(1) - 17*A(6)*B(0),
  15*A(0)*B(7) + 10*A(1)*B(6) + 5*A(2)*B(5) - 5*A(4)*B(3) - 10*A(5)*B(2) - 15*A(6)*B(1) - 20*A(7)*B(0),
  17*A(0)*B(8) + 12*A(1)*B(7) + 7*A(2)*B(6) + 2*A(3)*B(5) - 3*A(4)*B(4) - 8*A(5)*B(3) - 13*A(6)*B(2) - 18*A(7)*B(1),
  19*A(0)*B(9) + 14*A(1)*B(8) + 9*A(2)*B(7) + 4*A(3)*B(6) - A(4)*B(5) - 6*A(5)*B(4) - 11*A(6)*B(3) - 16*A(7)*B(2),
  21*A(0)*B(10) + 16*A(1)*B(9) + 11*A(2)*B(8) + 6*A(3)*B(7) + A(4)*B(6) - 4*A(5)*B(5) - 9*A(6)*B(4) - 14*A(7)*B(3),
  18*A(1)*B(10) + 13*A(2)*B(9) + 8*A(3)*B(8) + 3*A(4)*B(7) - 2*A(5)*B(6) - 7*A(6)*B(5) - 12*A(7)*B(4),
  15*A(2)*B(10) + 10*A(3)*B(9) + 5*A(4)*B(8) - 5*A(6)*B(6) - 10*A(7)*B(5),
  12*A(3)*B(10) + 7*A(4)*B(9) + 2*A(5)*B(8) - 3*A(6)*B(7) - 8*A(7)*B(6),
  9*A(4)*B(10) + 4*A(5)*B(9) - A(6)*B(8) - 6*A(7)*B(7),
  6*A(5)*B(10) + A(6)*B(9) - 4*A(7)*B(8),
  3*A(6)*B(10) - 2*A(7)*B(9);
I = I + ideal(z*A(0)*A(7) - 1);
"variables: 19 + 1 rabinowitsch";
int t0=timer;
ideal G = std(I);
"time: "+string(timer-t0);
if (size(G)==1 && G[1]==1) { "VERDICT: CORE EMPTY"; } else { "VERDICT: core dim = "+string(dim(G)); if (dim(G)==0) {"vdim = "+string(vdim(G));} }
quit;