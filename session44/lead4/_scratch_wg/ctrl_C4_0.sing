ring R = 0, (v(1..3), zz), dp;
ideal I = 0;
poly nd = (v(1)) * (v(3)) * (v(1)^2*v(3));
I = I + ideal(zz*nd - 1);
int t0 = timer;
list LL = facstd(I);
"time: " + string(timer - t0);
"components: " + string(size(LL));
int ii; int alive = 0; int dmax = -1;
for (ii = 1; ii <= size(LL); ii++) {
  ideal Gi = std(LL[ii]);
  if (size(Gi) != 1 || Gi[1] != 1) { alive = alive + 1;
    if (dim(Gi) > dmax) { dmax = dim(Gi); }
    "  live component " + string(ii) + ": dim " + string(dim(Gi)); }
}
if (alive == 0) { "VERDICT: EMPTY"; } else { "VERDICT: " + string(alive) + " live component(s), max dim " + string(dmax); }
quit;