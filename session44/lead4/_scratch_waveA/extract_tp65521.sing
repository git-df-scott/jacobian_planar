poly nd = c(2) * c(56) * c(66) * c(74);
I = I + ideal(w*p10 - 1);
I = I + ideal(u*nd - 1);
"params: " + string(74);
"conditions: " + string(size(simplify(I,2)));
int t0 = timer;
list LL = facstd(I);
"time: " + string(timer - t0);
"components: " + string(size(LL));
int ii; int alive = 0; int dmax = -1;
for (ii = 1; ii <= size(LL); ii++) {
  ideal Gi = std(LL[ii]);
  if (size(Gi) != 1 || Gi[1] != 1) { alive = alive + 1;
    if (dim(Gi) > dmax) { dmax = dim(Gi); }
    "  live component " + string(ii) + ": dim " + string(dim(Gi)) + (dim(Gi)==0 ? ", vdim " + string(vdim(Gi)) : ""); }
}
if (alive == 0) { "VERDICT: EMPTY -- no non-degenerate realization"; }
else { "VERDICT: " + string(alive) + " live component(s), max dim " + string(dmax); }
quit;