ring R = 0, (a1,a2,a3,a4,a5,a6), dp;
poly b0 = 1;
poly b1 = -((-2)*a1*b0) / 3;
poly b2 = -((-5)*a2*b0) / 5;
poly b3 = -((2)*a1*b2 + (-3)*a2*b1 + (-8)*a3*b0) / 7;
poly b4 = -((4)*a1*b3 + (-1)*a2*b2 + (-6)*a3*b1 + (-11)*a4*b0) / 9;
poly b5 = -((6)*a1*b4 + (1)*a2*b3 + (-4)*a3*b2 + (-9)*a4*b1 + (-14)*a5*b0) / 11;
poly b6 = -((8)*a1*b5 + (3)*a2*b4 + (-2)*a3*b3 + (-7)*a4*b2 + (-12)*a5*b1 + (-17)*a6*b0) / 13;
poly b7 = -((10)*a1*b6 + (5)*a2*b5 + (-5)*a4*b3 + (-10)*a5*b2 + (-15)*a6*b1 + (-20)*1*b0) / 15;
poly b8 = -((12)*a1*b7 + (7)*a2*b6 + (2)*a3*b5 + (-3)*a4*b4 + (-8)*a5*b3 + (-13)*a6*b2 + (-18)*1*b1) / 17;
poly b9 = -((14)*a1*b8 + (9)*a2*b7 + (4)*a3*b6 + (-1)*a4*b5 + (-6)*a5*b4 + (-11)*a6*b3 + (-16)*1*b2) / 19;
poly b10 = -((16)*a1*b9 + (11)*a2*b8 + (6)*a3*b7 + (1)*a4*b6 + (-4)*a5*b5 + (-9)*a6*b4 + (-14)*1*b3) / 21;
poly E1 = (18)*a1*b10 + (13)*a2*b9 + (8)*a3*b8 + (3)*a4*b7 + (-2)*a5*b6 + (-7)*a6*b5 + (-12)*1*b4;
poly E2 = (15)*a2*b10 + (10)*a3*b9 + (5)*a4*b8 + (-5)*a6*b6 + (-10)*1*b5;
poly E3 = (12)*a3*b10 + (7)*a4*b9 + (2)*a5*b8 + (-3)*a6*b7 + (-8)*1*b6;
poly E4 = (9)*a4*b10 + (4)*a5*b9 + (-1)*a6*b8 + (-6)*1*b7;
poly E5 = (6)*a5*b10 + (1)*a6*b9 + (-4)*1*b8;
poly E6 = (3)*a6*b10 + (-2)*1*b9;
"residual equations: 6  unknowns: 6";
"E1 deg " + string(deg(E1)) + " terms " + string(size(E1));
"E2 deg " + string(deg(E2)) + " terms " + string(size(E2));
"E3 deg " + string(deg(E3)) + " terms " + string(size(E3));
"E4 deg " + string(deg(E4)) + " terms " + string(size(E4));
"E5 deg " + string(deg(E5)) + " terms " + string(size(E5));
"E6 deg " + string(deg(E6)) + " terms " + string(size(E6));
link ll = "write: /home/user/jacobian_planar/session44/lead4/_scratch_case1/case1_red_k3_c0.txt"; 
write(ll, string(E1));
write(ll, string(E2));
write(ll, string(E3));
write(ll, string(E4));
write(ll, string(E5));
write(ll, string(E6));
close(ll);
ideal I = E1,E2,E3,E4,E5,E6;
int t0 = timer; ideal G = std(I);
"std time " + string(timer-t0);
if (size(G)==1 && G[1]==1) { "VERDICT: EMPTY"; } else { "VERDICT: NONEMPTY dim " + string(dim(G)); if (dim(G)==0) { "vdim " + string(vdim(G)); } }
quit;