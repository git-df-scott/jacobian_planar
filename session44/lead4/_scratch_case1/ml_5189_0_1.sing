ring R = 5189, (t1,t2,t3,t4,t5,t6,t7,t8,t9,z), dp;
ideal I = 143*t2^4+3664*t2^2*t5+4347*t5^2,
949*t2^4+1201*t2^2*t5+3375*t5^2,
2389*t1^5+2941*t1^4*t2+2057*t1^3*t2^2+120*t1^3*t4+4639*t1^3*t5+376*t1^2*t2^3+4056*t1^2*t2*t4+4065*t1^2*t2*t5+3706*t1^2*t7+1851*t1^2*t8+4428*t1*t2^4+1604*t1*t2^2*t4+4291*t1*t2^2*t5+3117*t1*t2*t7+985*t1*t2*t8+1687*t1*t4^2+3279*t1*t4*t5+3432*t1*t5^2+4654*t1*t9+1586*t2^5+4562*t2^3*t4+2391*t2^3*t5+374*t2^2*t7+4477*t2^2*t8+2554*t2*t4^2+5096*t2*t4*t5+1864*t2*t5^2+182*t9*t2+5000*t4*t7+1078*t4*t8+1078*t5*t7+2522*t5*t8,
4764*t1*t2^4+1540*t1*t2^2*t5+4345*t1*t5^2+76*t2^5+616*t2^3*t4+3432*t2^3*t5+4345*t2^2*t8+3501*t2*t4*t5+436*t2*t5^2+2178*t5*t8;
I = I + ideal(z*((524*t2^2+3665*t5)*(2079*t2^3+4427*t2*t5)) - 1);
list LL = facstd(I); int i; int alive = 0;
for (i=1;i<=size(LL);i++) { ideal Gi = std(LL[i]);
 if (size(Gi)!=1 || Gi[1]!=1) { alive = alive+1; } }
if (alive==0) { "EMPTY"; } else { "alive " + string(alive); }
quit;