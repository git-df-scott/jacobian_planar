ring R = 0, (x,y,h2,h14,h29,h41,A,B,a,b), dp;
poly H = h2*x^2*y^40 + h14*x^14*y^28 + h29*x^29*y^13 + h41*x^41*y;
poly P0 = A*H^2;  poly Q0 = B*H^3;
poly br0 = diff(P0,x)*diff(Q0,y) - diff(P0,y)*diff(Q0,x);
"S1 leading bracket is zero:", br0 == 0;
"S1 deg P0, deg Q0:", deg(P0), deg(Q0);
poly P1 = A*H^2 + a*x;  poly Q1 = B*H^3 + b*y;
poly br1 = diff(P1,x)*diff(Q1,y) - diff(P1,y)*diff(Q1,x);
poly pred = a*b + A*b*diff(H^2,x) + a*B*diff(H^3,y);
"S2 degenerate bracket equals independent expansion:", br1 - pred == 0;
proc getc(poly f, poly m) { matrix C = coef(f, xy); int i; for(i=1;i<=ncols(C);i++){ if(C[1,i]==m){ return(C[2,i]); } } return(0); }
"S2 coeff at 1        :", getc(br1, 1), " expected ", a*b;
"S2 coeff at x3y80    :", getc(br1, x^3*y^80), " expected ", 4*A*b*h2^2;
"S2 coeff at x123y2   :", getc(br1, x^123*y^2), " expected ", 3*a*B*h41^3;
"S2 all three match:", (getc(br1,1)-a*b==0) && (getc(br1,x^3*y^80)-4*A*b*h2^2==0) && (getc(br1,x^123*y^2)-3*a*B*h41^3==0);
ring R2 = 0, (x,y), dp;
poly H2 = 1*x^2*y^40 + 19*x^14*y^28 + 18*x^29*y^13 + 14*x^41*y;
poly P = 18*H2^2 + (27)*x^1*y^0 + (-2)*x^7*y^3 + (-25)*x^4*y^6 + (18)*x^1*y^9 + (-33)*x^10*y^9 + (-2)*x^13*y^6 + (11)*x^1*y^18 + (-37)*x^7*y^12 + (8)*x^4*y^15 + (9)*x^16*y^3 + (-12)*x^22*y^6 + (8)*x^10*y^18 + (16)*x^7*y^21 + (29)*x^19*y^9 + (-18)*x^4*y^24 + (-1)*x^13*y^15 + (-11)*x^25*y^3 + (-23)*x^16*y^12 + (-26)*x^73*y^2 + (20)*x^70*y^5 + (-23)*x^58*y^17 + (-18)*x^61*y^14 + (-6)*x^55*y^20 + (17)*x^67*y^8 + (-11)*x^64*y^11 + (-31)*x^52*y^23 + (6)*x^49*y^26 + (-25)*x^46*y^29 + (-30)*x^43*y^32 + (-15)*x^40*y^35 + (15)*x^37*y^38 + (-29)*x^34*y^41 + (-35)*x^31*y^44 + (15)*x^28*y^47 + (24)*x^25*y^50 + (-34)*x^22*y^53 + (-6)*x^19*y^56 + (4)*x^7*y^68 + (-7)*x^4*y^71 + (1)*x^16*y^59 + (-36)*x^10*y^65 + (39)*x^13*y^62 + (-17)*x^34*y^3 + (32)*x^22*y^15 + (-28)*x^19*y^18 + (16)*x^31*y^6 + (28)*x^10*y^27 + (-33)*x^7*y^30 + (-8)*x^4*y^33 + (-15)*x^16*y^21 + (-24)*x^13*y^24 + (8)*x^25*y^12 + (2)*x^28*y^9 + (12)*x^13*y^4 + (-33)*x^1*y^16 + (9)*x^4*y^13 + (-15)*x^16*y^1 + (24)*x^7*y^10 + (21)*x^10*y^7 + (-14)*x^7*y^1 + (30)*x^4*y^4 + (-19)*x^1*y^7 + (-16)*x^22*y^4 + (7)*x^10*y^16 + (38)*x^7*y^19 + (9)*x^19*y^7 + (10)*x^4*y^22 + (-37)*x^16*y^10 + (7)*x^13*y^13 + (29)*x^25*y^1 + (-18)*x^34*y^1 + (13)*x^22*y^13 + (-13)*x^10*y^25 + (26)*x^7*y^28 + (31)*x^19*y^16 + (8)*x^31*y^4 + (-17)*x^4*y^31 + (-4)*x^16*y^19 + (-25)*x^13*y^22 + (-12)*x^25*y^10 + (9)*x^28*y^7 + (32)*x^4*y^38 + (-22)*x^7*y^35 + (-36)*x^10*y^32 + (11)*x^13*y^29 + (-10)*x^16*y^26 + (28)*x^19*y^23 + (-15)*x^22*y^20 + (32)*x^40*y^2 + (19)*x^37*y^5 + (-14)*x^28*y^14 + (20)*x^31*y^11 + (-12)*x^25*y^17 + (-6)*x^34*y^8 + (28)*x^4*y^29 + (21)*x^7*y^26;
poly Q = 17*H2^3 + (6)*x^0*y^1 + (7)*x^3*y^40 + (15)*x^15*y^28 + (-1)*x^30*y^13 + (-37)*x^18*y^25 + (-2)*x^6*y^37 + (26)*x^33*y^10 + (-35)*x^21*y^22 + (34)*x^9*y^34 + (-37)*x^36*y^7 + (-33)*x^24*y^19 + (6)*x^12*y^31 + (-10)*x^27*y^16 + (-13)*x^39*y^4 + (-17)*x^15*y^69 + (-14)*x^27*y^57 + (-28)*x^42*y^42 + (33)*x^54*y^30 + (-16)*x^30*y^54 + (28)*x^57*y^27 + (-38)*x^69*y^15 + (29)*x^81*y^3 + (22)*x^18*y^66 + (-17)*x^45*y^39 + (-16)*x^6*y^78 + (-29)*x^33*y^51 + (-4)*x^21*y^63 + (-32)*x^9*y^75 + (-32)*x^12*y^72 + (9)*x^24*y^60 + (-6)*x^36*y^48 + (-37)*x^48*y^36 + (29)*x^60*y^24 + (-2)*x^72*y^12 + (38)*x^39*y^45 + (25)*x^51*y^33 + (-12)*x^63*y^21 + (34)*x^75*y^9 + (37)*x^66*y^18 + (6)*x^78*y^6 + (-12)*x^3*y^6 + (-34)*x^6*y^3 + (1)*x^6*y^86 + (-34)*x^18*y^74 + (31)*x^45*y^47 + (35)*x^33*y^59 + (16)*x^21*y^71 + (30)*x^9*y^83 + (-36)*x^36*y^56 + (-18)*x^48*y^44 + (20)*x^72*y^20 + (34)*x^60*y^32 + (35)*x^63*y^29 + (-16)*x^75*y^17 + (13)*x^87*y^5 + (23)*x^84*y^8 + (-24)*x^57*y^35 + (-1)*x^30*y^62 + (13)*x^42*y^50 + (-29)*x^69*y^23 + (-12)*x^15*y^77 + (-38)*x^27*y^65 + (7)*x^39*y^53 + (35)*x^51*y^41 + (29)*x^24*y^68 + (29)*x^12*y^80 + (-1)*x^54*y^38 + (-28)*x^81*y^11 + (36)*x^66*y^26 + (30)*x^78*y^14 + (-22)*x^3*y^60 + (-17)*x^15*y^48 + (-15)*x^27*y^36 + (8)*x^39*y^24 + (-20)*x^12*y^51 + (-31)*x^30*y^33 + (-21)*x^42*y^21 + (30)*x^54*y^9 + (19)*x^18*y^45 + (-11)*x^6*y^57 + (-27)*x^33*y^30 + (38)*x^45*y^18 + (23)*x^57*y^6 + (-9)*x^9*y^54 + (32)*x^21*y^42 + (-39)*x^51*y^12 + (-18)*x^24*y^39 + (32)*x^36*y^27 + (39)*x^48*y^15 + (17)*x^60*y^3 + (-20)*x^6*y^12 + (-27)*x^9*y^9 + (-20)*x^12*y^6 + (-34)*x^15*y^3 + (-13)*x^3*y^15 + (7)*x^6*y^95 + (26)*x^33*y^68 + (6)*x^21*y^80 + (32)*x^9*y^92 + (23)*x^18*y^83 + (-11)*x^45*y^56 + (5)*x^36*y^65 + (3)*x^48*y^53 + (-23)*x^60*y^41 + (-17)*x^72*y^29 + (33)*x^24*y^77 + (-18)*x^12*y^89 + (-15)*x^15*y^86 + (4)*x^27*y^74 + (-10)*x^39*y^62 + (-23)*x^51*y^50 + (18)*x^63*y^38 + (-3)*x^75*y^26 + (-12)*x^87*y^14 + (27)*x^30*y^71 + (22)*x^84*y^17 + (-7)*x^57*y^44 + (16)*x^42*y^59 + (-30)*x^54*y^47 + (-6)*x^66*y^35 + (4)*x^78*y^23 + (-5)*x^90*y^11 + (12)*x^96*y^5 + (-37)*x^69*y^32 + (-4)*x^81*y^20 + (8)*x^93*y^8 + (-29)*x^9*y^18 + (18)*x^21*y^6 + (17)*x^6*y^21 + (-19)*x^18*y^9 + (-22)*x^3*y^24 + (26)*x^15*y^12 + (-30)*x^12*y^15 + (33)*x^24*y^3 + (38)*x^6*y^104 + (7)*x^18*y^92 + (1)*x^30*y^80 + (18)*x^42*y^68 + (17)*x^15*y^95 + (-8)*x^27*y^83 + (30)*x^54*y^56 + (16)*x^33*y^77 + (-29)*x^45*y^65 + (-22)*x^57*y^53 + (1)*x^69*y^41 + (24)*x^81*y^29 + (19)*x^21*y^89 + (-9)*x^9*y^101 + (-31)*x^12*y^98 + (35)*x^24*y^86 + (9)*x^36*y^74 + (19)*x^48*y^62 + (7)*x^60*y^50 + (-10)*x^72*y^38 + (17)*x^84*y^26 + (-29)*x^96*y^14 + (19)*x^39*y^71 + (-10)*x^51*y^59 + (4)*x^63*y^47 + (-20)*x^75*y^35 + (17)*x^87*y^23 + (24)*x^99*y^11 + (-22)*x^66*y^44 + (-2)*x^93*y^17 + (-30)*x^105*y^5 + (-34)*x^78*y^32 + (31)*x^90*y^20 + (24)*x^102*y^8 + (31)*x^12*y^24 + (8)*x^24*y^12 + (11)*x^9*y^27 + (-23)*x^21*y^15 + (3)*x^33*y^3 + (4)*x^6*y^30 + (5)*x^18*y^18 + (-31)*x^15*y^21 + (6)*x^3*y^33 + (22)*x^27*y^9 + (-21)*x^30*y^6 + (-27)*x^6*y^113 + (39)*x^18*y^101 + (19)*x^30*y^89 + (-3)*x^42*y^77 + (19)*x^15*y^104 + (-35)*x^27*y^92 + (20)*x^54*y^65 + (-32)*x^33*y^86 + (-39)*x^45*y^74 + (15)*x^57*y^62 + (-22)*x^69*y^50 + (-36)*x^81*y^38 + (35)*x^108*y^11 + (-18)*x^96*y^23 + (-30)*x^84*y^35 + (-37)*x^60*y^59 + (-26)*x^72*y^47 + (18)*x^39*y^80 + (2)*x^66*y^53 + (38)*x^93*y^26 + (34)*x^12*y^107 + (26)*x^24*y^95 + (3)*x^36*y^83 + (31)*x^48*y^71 + (10)*x^9*y^110 + (10)*x^21*y^98 + (-14)*x^51*y^68 + (-20)*x^105*y^14 + (-1)*x^78*y^41 + (13)*x^63*y^56 + (-27)*x^75*y^44 + (-28)*x^87*y^32 + (-17)*x^99*y^20 + (-33)*x^111*y^8 + (32)*x^90*y^29 + (1)*x^102*y^17 + (-38)*x^114*y^5 + (-3)*x^15*y^30 + (30)*x^3*y^42 + (-10)*x^30*y^15 + (-3)*x^42*y^3 + (37)*x^18*y^27 + (36)*x^6*y^39 + (10)*x^33*y^12 + (21)*x^21*y^24 + (5)*x^9*y^36 + (33)*x^36*y^9 + (-21)*x^24*y^21 + (20)*x^12*y^33 + (15)*x^27*y^18 + (6)*x^39*y^6 + (39)*x^18*y^36 + (-5)*x^45*y^9 + (-5)*x^6*y^48 + (6)*x^33*y^21 + (22)*x^21*y^33 + (3)*x^9*y^45 + (-27)*x^36*y^18 + (6)*x^48*y^6 + (-4)*x^24*y^30 + (39)*x^12*y^42 + (5)*x^39*y^15 + (26)*x^51*y^3 + (-2)*x^27*y^27 + (-11)*x^15*y^39 + (-38)*x^3*y^51 + (18)*x^30*y^24 + (-24)*x^42*y^12 + (-11)*x^24*y^48 + (-22)*x^12*y^60 + (-10)*x^39*y^33 + (-15)*x^51*y^21 + (-23)*x^27*y^45 + (19)*x^15*y^57 + (-26)*x^42*y^30 + (-7)*x^54*y^18 + (-5)*x^66*y^6;
poly br = diff(P,x)*diff(Q,y) - diff(P,y)*diff(Q,x);
proc getc2(poly f, poly m) { matrix C = coef(f, xy); int i; for(i=1;i<=ncols(C);i++){ if(C[1,i]==m){ return(C[2,i]); } } return(0); }
"S3 params: h2=1, h14=19, h29=18, h41=14, A=18, B=17";
"S3 deg P, deg Q:", deg(P), deg(Q);
"S3 coeff at x3y80  :", getc2(br, x^3*y^80), " expected ", 432;
"S3 coeff at x123y2 :", getc2(br, x^123*y^2), " expected ", 3778488;
"S3 coeff at 1      :", getc2(br, 1), " expected ", 162;
"S3 all three match:", (getc2(br,x^3*y^80)==432) && (getc2(br,x^123*y^2)==3778488) && (getc2(br,1)==162);
exit;
